@{
    ViewData["Title"] = "SwiftFill - Smart Fulfillment";
    Layout = "_Layout";
}

<style>
    :root {
        --swift-orange: #ff8c00;
        --swift-orange-glow: rgba(255, 140, 0, 0.3);
        --glass-bg: var(--card-bg);
        --glass-border: var(--border-color);
    }

    .tracking-search-input::placeholder {
        color: var(--text-secondary) !important;
        opacity: 0.5;
    }

    /* Hero Section */
    .hero-container {
        min-height: 90vh;
        text-align: center;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 100px 0 60px;
        background: radial-gradient(circle at center, rgba(255,140,0,0.05) 0%, transparent 70%);
    }
    
    .hero-title {
        font-size: clamp(2rem, 8vw, 5rem);
        font-weight: 800;
        letter-spacing: -1.5px;
        line-height: 1.1;
        margin-bottom: 20px;
        color: var(--text-primary);
    }

    .text-orange {
        color: var(--swift-orange);
    }

    .hero-subtitle {
        font-size: clamp(0.95rem, 2vw, 1.1rem);
        color: var(--text-secondary);
        max-width: 650px;
        margin: 0 auto 40px;
        line-height: 1.6;
    }

    /* Stats Banner */
    .stats-banner {
        border-top: 1px solid var(--glass-border);
        border-bottom: 1px solid var(--glass-border);
        background: rgba(255,255,255,0.01);
        padding: 50px 0;
    }

    .stat-item h3 {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 800;
        margin-bottom: 5px;
        color: var(--swift-orange);
    }

    .stat-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: var(--text-secondary);
    }

    /* Feature Cards */
    .glass-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        padding: 40px 30px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
    }

    .glass-card:hover {
        transform: translateY(-10px);
        border-color: rgba(255, 140, 0, 0.3);
        background: var(--card-bg-hover);
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }

    .icon-wrapper {
        font-size: 1.8rem;
        color: var(--swift-orange);
        margin-bottom: 25px;
        background: rgba(255, 140, 0, 0.08);
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        border: 1px solid rgba(255, 140, 0, 0.15);
    }

    /* Button Styles */
    .btn-primary-custom {
        background: var(--swift-orange);
        color: #000 !important;
        font-weight: 700;
        padding: 12px 28px;
        border-radius: 10px;
        text-decoration: none;
        transition: 0.3s;
        display: inline-block;
    }

    .btn-outline-custom {
        border: 1px solid var(--border-color);
        color: var(--text-primary) !important;
        padding: 12px 28px;
        border-radius: 10px;
        text-decoration: none;
        transition: 0.3s;
        display: inline-block;
    }

    .btn-outline-custom:hover {
        background: rgba(255,255,255,0.05);
        border-color: #fff;
    }

    /* Mobile Adjustments */
    @@media (max-width: 767.98px) {
        .hero-container {
            padding: 120px 0 60px;
            min-height: auto;
        }
        .hero-title br {
            display: none;
        }
        .hero-title div {
            white-space: normal !important;
        }
        .stats-banner {
            padding: 40px 0;
        }
        .glass-card {
            padding: 30px 20px;
        }
        .btn-primary-custom, .btn-outline-custom {
            margin-bottom: 10px;
            text-align: center;
        }
        .btn-outline-custom {
            margin-left: 0 !important;
        }
    }
</style>

<section class="hero-container">
    <div class="container">
        <div class="animate-fade-up">
            <h1 class="hero-title">
                Precision in Every <span class="text-orange">Pack.</span><br>
                <div style="white-space: nowrap;">Speed in Every <span class="text-orange">Shipment.</span></div>
            </h1>
        </div>
        <div class="animate-fade-up delay-100">
            <p class="hero-subtitle">
                The intelligent fulfillment engine for the modern hub. Automate your entire lifecycle from order entry in Davao to final delivery nationwide.
            </p>
        </div>
        
        <div class="mt-4 mb-5 animate-fade-up delay-150" style="max-width: 550px; margin: 0 auto; width: 100%;">
            <form action="/Home/Track" method="get" class="d-flex flex-column flex-sm-row align-items-center gap-2 p-1" style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 25px;">
                <div class="d-flex align-items-center flex-grow-1 w-100">
                    <i class="bi bi-search ms-3 text-secondary"></i>
                    <input type="text" name="trackingId" class="form-control tracking-search-input bg-transparent border-0 text-primary px-3" placeholder="Enter Tracking ID..." required style="box-shadow: none; min-width: 100px;">
                </div>
                <button type="submit" class="btn btn-warning rounded-pill px-4 py-2 fw-bold" style="background: var(--swift-orange); border: none; color: #000; font-size: 0.9rem; white-space: nowrap;">Search</button>
            </form>
        </div>
        
        <div class="mt-4 animate-fade-up delay-200 d-flex flex-column flex-md-row justify-content-center gap-3">
            <a href="/Account/SignUp" class="btn-primary-custom">Get Started Now &rarr;</a>
            <a href="#modules" class="btn-outline-custom">Explore Modules</a>
        </div>
    </div>
</section>

<section class="stats-banner">
    <div class="container">
        <div class="row g-4 text-center justify-content-center">
            <div class="col-6 col-md-4">
                <div class="stat-item">
                    <h3>99.9%</h3>
                    <p class="stat-label">Accuracy</p>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="stat-item">
                    <h3>3x</h3>
                    <p class="stat-label">Faster</p>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="stat-item">
                    <h3>100k+</h3>
                    <p class="stat-label">Daily Parcels</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="py-5 mt-lg-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">Powerful <span class="text-orange">Features</span></h2>
            <p class="hero-subtitle">Everything you need to scale your logistics operations.</p>
        </div>
        
        <div class="row g-4">
            <div class="col-md-4 col-sm-6">
                <div class="glass-card">
                    <div class="icon-wrapper"><i class="bi bi-geo-alt"></i></div>
                    <h3 class="fw-bold text-primary mb-3" style="font-size: 1.5rem;">Nationwide Hubs</h3>
                    <p class="text-secondary px-2" style="font-size: 0.95rem; line-height: 1.6;">Strategic logistics management across NCR, Luzon, Visayas, and Mindanao hubs.</p>
                </div>
            </div>
            <div class="col-md-4 col-sm-6">
                <div class="glass-card">
                    <div class="icon-wrapper"><i class="bi bi-search"></i></div>
                    <h3 class="fw-bold text-primary mb-3" style="font-size: 1.5rem;">Live Tracking</h3>
                    <p class="text-secondary px-2" style="font-size: 0.95rem; line-height: 1.6;">End-to-end visibility with real-time status updates for both customers and staff.</p>
                </div>
            </div>
            <div class="col-md-4 col-sm-12">
                <div class="glass-card">
                    <div class="icon-wrapper"><i class="bi bi-shield-lock"></i></div>
                    <h3 class="fw-bold text-primary mb-3" style="font-size: 1.5rem;">Secure Audit</h3>
                    <p class="text-secondary px-2" style="font-size: 0.95rem; line-height: 1.6;">Comprehensive activity tracking and financial reconciliation for full accountability.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modules Section -->
<section id="modules" class="py-5 mt-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">Core <span class="text-orange">Modules</span></h2>
            <p class="hero-subtitle">A centralized ecosystem designed for the complete chain of custody.</p>
        </div>
        
        <div class="row g-4 justify-content-center">
            <div class="col-lg-4 col-md-6">
                <a href="/Account/Login" class="text-decoration-none h-100 d-block">
                    <div class="glass-card">
                        <div class="icon-wrapper"><i class="bi bi-shield-check"></i></div>
                        <h3 class="h4 mb-3 text-primary">Admin Command</h3>
                        <p class="text-secondary small">Complete oversight of revenue, hub performance, and nationwide logistics audit logs.</p>
                        <span class="text-orange mt-auto pt-3 small fw-bold">Learn More &rarr;</span>
                    </div>
                </a>
            </div>
            <div class="col-lg-4 col-md-6">
                <a href="/Account/Login" class="text-decoration-none h-100 d-block">
                    <div class="glass-card">
                        <div class="icon-wrapper"><i class="bi bi-box-seam"></i></div>
                        <h3 class="h4 mb-3 text-primary">Fulfillment Staff</h3>
                        <p class="text-secondary small">Streamlined "Pick-Pack-Ship" interfaces optimized for high-speed warehouse sorting.</p>
                        <span class="text-orange mt-auto pt-3 small fw-bold">Learn More &rarr;</span>
                    </div>
                </a>
            </div>
            <div class="col-lg-4 col-md-6">
                <a href="/Account/Login" class="text-decoration-none h-100 d-block">
                    <div class="glass-card">
                        <div class="icon-wrapper"><i class="bi bi-truck"></i></div>
                        <h3 class="h4 mb-3 text-primary">Rider Dispatch</h3>
                        <p class="text-secondary small">Real-time last-mile delivery management with integrated COD and status tracking.</p>
                        <span class="text-orange mt-auto pt-3 small fw-bold">Learn More &rarr;</span>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Pricing Section -->
<section id="pricing" class="py-5 mt-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="display-5 fw-bold mb-3">Murang <span class="text-orange">Shipping</span></h2>
            <p class="hero-subtitle">Mura at mabilis na padala saan man sa Pilipinas.</p>
        </div>
        
        <div class="row g-4 justify-content-center">
            <div class="col-lg-4 col-md-6">
                <div class="glass-card border-0" style="background: rgba(255,255,255,0.02);">
                    <h4 class="mb-3 text-primary">Small Pouch</h4>
                    <p class="text-secondary small mb-4">(Maliit na Padala)</p>
                    <div class="display-6 fw-bold mb-4 text-primary">₱95<span class="fs-6 text-secondary">/up</span></div>
                    <ul class="list-unstyled text-start mb-5 text-secondary small">
                        <li class="mb-3"><i class="bi bi-check2 text-orange me-2"></i> Para sa Dokumento</li>
                        <li class="mb-3"><i class="bi bi-check2 text-orange me-2"></i> Small gadgets (Phones)</li>
                        <li class="mb-3"><i class="bi bi-check2 text-orange me-2"></i> Up to 1kg weight</li>
                    </ul>
                    <a href="/Customer/Book" class="btn-outline-custom w-100">Padala Na</a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="glass-card border-orange" style="background: rgba(255, 140, 0, 0.05); border: 2px solid var(--swift-orange);">
                    <div class="badge bg-warning text-dark rounded-pill px-3 py-1 mb-3 position-absolute top-0 start-50 translate-middle">SULIT</div>
                    <h4 class="mb-3 text-primary">Medium Box</h4>
                    <p class="text-secondary small mb-4">(Sakto sa Damit at Gamit)</p>
                    <div class="display-6 fw-bold mb-4 text-primary">₱245<span class="fs-6 text-secondary">/up</span></div>
                    <ul class="list-unstyled text-start mb-5 text-secondary small">
                        <li class="mb-3"><i class="bi bi-check2 text-orange me-2"></i> Pang-Damit o Sapatos</li>
                        <li class="mb-3"><i class="bi bi-check2 text-orange me-2"></i> Bulk orders ng items</li>
                        <li class="mb-3"><i class="bi bi-check2 text-orange me-2"></i> Up to 5kg weight</li>
                    </ul>
                    <a href="/Customer/Book" class="btn-primary-custom w-100">Book Order</a>
                </div>
            </div>
            <div class="col-lg-4 col-md-10">
                <div class="glass-card border-0" style="background: rgba(255,255,255,0.02);">
                    <h4 class="mb-3 text-primary">Large Cargo</h4>
                    <p class="text-secondary small mb-4">(Pang-Negosyo o Balikbayan)</p>
                    <div class="display-6 fw-bold mb-4 text-primary">₱850<span class="fs-6 text-secondary">/up</span></div>
                    <ul class="list-unstyled text-start mb-5 text-secondary small">
                        <li class="mb-3"><i class="bi bi-check2 text-orange me-2"></i> Appliances o TV</li>
                        <li class="mb-3"><i class="bi bi-check2 text-orange me-2"></i> Extra heavy boxes</li>
                        <li class="mb-3"><i class="bi bi-check2 text-orange me-2"></i> Nationwide Shipping</li>
                    </ul>
                    <a href="#contact" class="btn-outline-custom w-100">Get a Quote</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section id="contact" class="py-5 mt-5 mb-5">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 text-center text-lg-start">
                <h2 class="display-5 fw-bold mb-4">Ready to <span class="text-orange">SwiftFill</span>?</h2>
                <p class="text-secondary mb-5 mx-auto mx-lg-0" style="max-width: 500px;">Join hundreds of hubs across the country optimizing their fulfillment today.</p>
                
                <div class="d-flex flex-column align-items-center align-items-lg-start gap-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-wrapper mb-0 me-3" style="width: 50px; height: 50px; font-size: 1.2rem;"><i class="bi bi-geo-alt"></i></div>
                        <div class="text-start">
                            <h5 class="mb-0 text-primary fs-6">Visit Us</h5>
                            <p class="text-secondary small mb-0">Davao City, Philippines</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="icon-wrapper mb-0 me-3" style="width: 50px; height: 50px; font-size: 1.2rem;"><i class="bi bi-envelope"></i></div>
                        <div class="text-start">
                            <h5 class="mb-0 text-primary fs-6">Email Us</h5>
                            <p class="text-secondary small mb-0">hello@swiftfill.ph</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="glass-card p-4 p-md-5">
                    <form action="/Home/Contact" method="post">
                        <div class="row g-3">
                            <div class="col-md-6 text-start">
                                <label class="form-label text-secondary small">Full Name</label>
                                <input type="text" name="name" class="form-control bg-transparent border-secondary text-primary" placeholder="John Doe" required>
                            </div>
                            <div class="col-md-6 text-start">
                                <label class="form-label text-secondary small">Email Address</label>
                                <input type="email" name="email" class="form-control bg-transparent border-secondary text-primary" placeholder="john@example.com" required>
                            </div>
                            <div class="col-12 text-start">
                                <label class="form-label text-secondary small">Subject</label>
                                <input type="text" name="subject" class="form-control bg-transparent border-secondary text-primary" placeholder="Inquiry about Enterprise" required>
                            </div>
                            <div class="col-12 text-start">
                                <label class="form-label text-secondary small">Message</label>
                                <textarea name="message" rows="4" class="form-control bg-transparent border-secondary text-primary" placeholder="How can we help you?" required></textarea>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn-primary-custom w-100 border-0">Send Message</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>