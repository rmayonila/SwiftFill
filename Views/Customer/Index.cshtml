@model IEnumerable<SwiftFill.Models.Order>
@{
    ViewData["Title"] = "My Dashboard";
    Layout = "_AdminLayout";
}

<div class="animate-fade-up">
    <!-- Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold fs-3 mt-2 mb-0 text-primary">
            <i class="bi bi-grid-fill text-orange me-2"></i> My Dashboard
        </h2>
        <div class="text-secondary small">Status: <span class="text-orange fw-bold">Active Account</span></div>
    </div>

    <!-- KPI Cards — Ported from Rider Dashboard -->
    <div class="row g-3 mb-5">
        <div class="col-6 col-md-4">
            <a href="?status=Active" class="text-decoration-none h-100 d-block hover-scale">
                <div class="glass-card active-border-blue p-4 h-100 d-flex justify-content-between align-items-center @(ViewBag.CurrentStatus == "Active" ? "active-border-blue" : "")">
                    <div>
                        <div class="stat-label text-primary fw-bold">ACTIVE</div>
                        <div class="stat-subtitle mt-1">Pending / Picking</div>
                    </div>
                    <div class="stat-value text-primary display-6 fw-bold mb-0">@(Model?.Count(o => o.Status != "Delivered" && o.Status != "Returned") ?? 0)</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            <a href="?status=Delivered" class="text-decoration-none h-100 d-block hover-scale">
                <div class="glass-card active-border-green p-4 h-100 d-flex justify-content-between align-items-center @(ViewBag.CurrentStatus == "Delivered" ? "active-border-green" : "")">
                    <div>
                        <div class="stat-label text-success fw-bold">DELIVERED</div>
                        <div class="stat-subtitle mt-1">Completed</div>
                    </div>
                    <div class="stat-value text-primary display-6 fw-bold mb-0">@(Model?.Count(o => o.Status == "Delivered") ?? 0)</div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-4">
            <a href="?status=Returns" class="text-decoration-none h-100 d-block hover-scale">
                <div class="glass-card active-border-orange p-4 h-100 d-flex justify-content-between align-items-center @(ViewBag.CurrentStatus == "Returns" ? "active-border-orange" : "")">
                    <div>
                        <div class="stat-label text-warning fw-bold">RETURNS</div>
                        <div class="stat-subtitle mt-1">Action Required</div>
                    </div>
                    <div class="stat-value text-primary display-6 fw-bold mb-0">@(Model?.Count(o => o.Status.Contains("Return")) ?? 0)</div>
                </div>
            </a>
        </div>
    </div>



    <div class="glass-card p-0 overflow-hidden mb-5" style="border: 1px solid var(--border-color); border-radius: 20px;">
        <!-- Unified Header: Title and Tracking -->
        <div class="p-4 border-bottom d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4" style="background: rgba(0,0,0,0.03); border-color: var(--border-color) !important;">
            <div class="d-flex align-items-center">
                <div class="bg-orange p-2 rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                    <i class="bi bi-clipboard-data-fill text-black fs-5"></i>
                </div>
                <div>
                    <h6 class="text-primary mb-0 fw-bold text-uppercase ls-1">Shipment Registry</h6>
                    <span class="text-secondary x-small">Manage and track your active logistics</span>
                </div>
            </div>

            <!-- Integrated Search/Tracking in Header (Repositioned) -->
            <form onsubmit="event.preventDefault(); showTracking(this.trackingId.value);" class="d-flex align-items-center bg-dark-soft rounded-3 px-3 py-2 border border-secondary border-opacity-10" style="min-width: 350px; background: rgba(255,255,255,0.02);">
                <i class="bi bi-upc-scan text-orange me-3"></i>
                <input type="text" name="trackingId" class="minimal-input bg-transparent border-0 x-small text-primary w-100 fw-bold ls-1" placeholder="ENTER TRACKING ID TO TRACK..." style="outline: none;" required />
                <button type="submit" class="btn btn-link text-orange p-0 ms-2"><i class="bi bi-search fs-5"></i></button>
            </form>
        </div>
        <div class="table-responsive">
            <table class="admin-style-table mb-0">
                <thead>
                    <tr>
                        <th class="ps-4 py-3">ID</th>
                        <th class="py-3">Receiver</th>
                        <th class="py-3">Destination</th>
                        <th class="py-3">Volume</th>
                        <th class="py-3">Status</th>
                        <th class="text-center py-3 pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <code class="text-orange fw-bold">@order.TrackingId</code>
                                </td>
                                <td>
                                    <div class="fw-bold text-primary">@order.ReceiverName</div>
                                </td>
                                <td>
                                    <div class="text-secondary small">@order.DestinationRegion</div>
                                </td>
                                <td>
                                    <div class="text-secondary small">@order.Weight kg</div>
                                </td>
                                <td>
                                    <span class="badge @(order.Status == "Delivered" ? "border-success text-success" : (order.Status.Contains("Return") ? "border-warning text-warning" : "border-primary text-primary")) border bg-transparent px-3" style="font-size: 0.65rem;">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <button class="btn btn-sm btn-link text-info p-0 action-icon" onclick="showOrderDetails('@order.TrackingId')" title="View Details">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>
                                        @if (order.Status != "Delivered" && order.Status != "Returned")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger border-0 p-1 action-icon" onclick="confirmDelete('@order.TrackingId')" title="Delete Shipment">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary border-0 opacity-25" title="Cannot delete once processed" disabled>
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-secondary">
                                <div class="opacity-50 mb-2" style="font-size: 3rem;"><i class="bi bi-inbox"></i></div>
                                No active records found in your registry.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Order Details Modal (Enhanced Tracking Design) -->
<div class="modal fade" id="orderDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-modal" style="background: var(--modal-bg); border: 1px solid var(--border-color); border-radius: 24px; overflow: hidden;">
            <div class="modal-header border-0 p-4 pb-0">
                <div class="d-flex align-items-center">
                    <div class="icon-glow-sm me-3">
                        <i class="bi bi-upc-scan text-orange fs-4"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-primary mb-0" id="mTrackingId"></h5>
                        <span class="text-secondary x-small text-uppercase ls-2">SECURED TRACKING LINK</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div id="modalLoading" class="text-center py-5">
                    <div class="spinner-border text-orange" role="status"></div>
                </div>
                <div id="modalContent" class="d-none">
                    <!-- Status Header -->
                    <div class="glass-card mb-4 p-3 border-0 border-start border-orange border-4 d-flex justify-content-between align-items-center" style="background: var(--bg-secondary);">
                        <div>
                            <span class="text-secondary x-small text-uppercase ls-1 d-block mb-1">Shipping Status</span>
                            <h4 class="text-primary fw-bold mb-0" id="mStatus"></h4>
                        </div>
                        <div class="text-end">
                            <span class="text-secondary x-small text-uppercase ls-1 d-block mb-1">Last Update</span>
                            <span class="text-secondary x-small" id="mDate"></span>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Shipment Meta -->
                        <div class="col-12">
                            <div class="p-4 rounded-4 h-100" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
                                <h6 class="text-orange small text-uppercase ls-1 mb-4 fw-bold">Shipment Details</h6>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="text-secondary x-small d-block mb-1">Sender</label>
                                            <div class="text-primary small fw-bold" id="mSender"></div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="text-secondary x-small d-block mb-1">Receiver</label>
                                            <div class="text-primary small fw-bold" id="mReceiver"></div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="text-secondary x-small d-block mb-1">Destination</label>
                                            <div class="text-primary small fw-bold" id="mDest"></div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="text-secondary x-small d-block mb-1">Service Type</label>
                                            <div class="text-primary small fw-bold" id="mDelivery"></div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="text-secondary x-small d-block mb-1">Package Info</label>
                                            <div class="text-primary small fw-bold"><span id="mWeight"></span>kg &bull; <span id="mCategory"></span></div>
                                        </div>
                                        <div id="pickupSection" class="mt-3 p-3 rounded-3 d-none" style="background: rgba(255,140,0,0.05);">
                                            <label class="text-orange x-small d-block mb-1 fw-bold">PICKUP HUB</label>
                                            <div class="text-primary small fw-bold" id="mBranch"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Issues / Return Section -->
                    <div id="returnReasonBlock" class="mt-4 p-4 rounded-4 d-none" style="background: rgba(220,53,69,0.05); border: 1px solid rgba(220,53,69,0.1);">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-4 me-3"></i>
                            <div>
                                <h6 class="text-danger small text-uppercase ls-1 mb-1 fw-bold">Resolution Required</h6>
                                <p class="text-secondary x-small mb-0" id="mReturnReason"></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tracking Status Modal (Full Format) -->
<div class="modal fade" id="trackingStatusModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="background: var(--modal-bg); border-radius: 24px; border: 1px solid var(--border-color) !important;">
            <div class="modal-header border-0 p-4 pb-0">
                <div class="d-flex align-items-center">
                    <div class="icon-glow-sm me-3">
                        <i class="bi bi-geo-alt-fill text-orange fs-4"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-primary mb-0" id="tTrackingId"></h5>
                        <span class="text-secondary x-small text-uppercase ls-2">REAL-TIME SHIPMENT TRACKING</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div id="tLoading" class="text-center py-5">
                    <div class="spinner-border text-orange" role="status"></div>
                </div>
                <div id="tContent" class="d-none">
                    <!-- Status Header -->
                    <div class="glass-card mb-4 p-3 border-0 border-top border-orange border-4" style="background: var(--bg-secondary);">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-secondary x-small text-uppercase ls-1 d-block mb-1">Status</span>
                                <h3 class="text-orange fw-bold mb-0" id="tStatus"></h3>
                            </div>
                            <div class="text-end">
                                <span class="text-secondary x-small text-uppercase ls-1 d-block mb-1">Last Update</span>
                                <span class="text-primary small fw-bold" id="tDate"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-5">
                            <div class="p-4 rounded-4 h-100" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
                                <h6 class="text-secondary small text-uppercase ls-1 mb-4 fw-bold"><i class="bi bi-info-circle me-2"></i> Shipment Info</h6>
                                <div class="mb-3 pb-2 border-bottom border-secondary border-opacity-10">
                                    <label class="text-secondary x-small d-block mb-1">Sender</label>
                                    <div class="text-primary small fw-bold" id="tSender"></div>
                                </div>
                                <div class="mb-3 pb-2 border-bottom border-secondary border-opacity-10">
                                    <label class="text-secondary x-small d-block mb-1">Receiver</label>
                                    <div class="text-primary small fw-bold" id="tReceiver"></div>
                                </div>
                                <div class="mb-3 pb-2 border-bottom border-secondary border-opacity-10">
                                    <label class="text-secondary x-small d-block mb-1">Destination</label>
                                    <div class="text-primary small fw-bold" id="tDest"></div>
                                </div>
                                <div class="mb-0">
                                    <label class="text-secondary x-small d-block mb-1">Package</label>
                                    <div class="text-primary small fw-bold"><span id="tWeight"></span>kg &bull; <span id="tCategory"></span></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div class="p-4 rounded-4 h-100" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
                                <h6 class="text-secondary small text-uppercase ls-1 mb-4 fw-bold"><i class="bi bi-geo-alt me-2"></i> Tracking Timeline</h6>
                                <div class="timeline-v2-full" id="tTimeline">
                                    <!-- Dynamic Timeline -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteOrderModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content border-0 shadow-lg" style="background: var(--modal-bg); border-radius: 16px; border: 1px solid rgba(220,53,69,0.2) !important;">
            <div class="modal-body text-center p-4">
                <div class="display-4 text-danger mb-3"><i class="bi bi-exclamation-octagon"></i></div>
                <h5 class="text-primary fw-bold mb-2">Delete Shipment?</h5>
                <p class="text-secondary small mb-4">Are you sure you want to delete shipment <strong id="deleteTrackingIdDisplay" class="text-primary"></strong>? This action cannot be undone.</p>
                <form asp-action="DeleteOrder" method="post" id="deleteOrderForm">
                    <input type="hidden" name="trackingId" id="deleteTrackingIdInput" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-dark flex-fill" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger flex-fill fw-bold">Yes, Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .ls-2 { letter-spacing: 2px; }
    .ls-1 { letter-spacing: 1px; }
    .x-small { font-size: 0.75rem; }
    .stat-subtitle { font-size: 0.8rem; color: var(--text-secondary); font-weight: 500; }
    .stat-label { font-size: 0.7rem; letter-spacing: 0.5px; opacity: 0.9; }
    .hover-scale { transition: transform 0.2s; }
    .hover-scale:hover { transform: translateY(-3px); }
    
    .glass-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        position: relative;
        overflow: hidden;
    }
    .t-event-full {
        position: relative;
        padding-bottom: 35px;
        border-left: 2px solid rgba(255,140,0,0.1);
        padding-left: 25px;
        margin-left: 10px;
        margin-bottom: 10px;
    }
    .t-event-full::before {
        content: '';
        position: absolute;
        left: -7px;
        top: 5px;
        width: 12px;
        height: 12px;
        background: #ff8c00;
        border-radius: 50%;
        box-shadow: 0 0 10px rgba(255,140,0,0.5);
    }
    .t-event-full:last-child {
        padding-bottom: 0;
        border-left: 2px solid transparent;
    }

    .active-border-orange::before, .active-border-green::before, .active-border-blue::before {
        content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px; border-radius: 16px 16px 0 0;
    }
    .active-border-orange::before { background: #ff8c00; box-shadow: 0 0 15px rgba(255,140,0,0.2); }
    .active-border-green::before { background: #198754; box-shadow: 0 0 15px rgba(25,135,84,0.2); }
    .active-border-blue::before { background: #3b82f6; box-shadow: 0 0 15px rgba(59,130,246,0.2); }

    .btn-orange {
        background: #ff8c00 !important; color: #000 !important; border: none !important; transition: all 0.2s ease;
    }
    .btn-orange:hover {
        background: #ff9d26 !important; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(255, 140, 0, 0.3);
    }

    .display-6 { font-size: 2rem; font-weight: 800; font-family: 'Sora', sans-serif; }
    
    .action-icon { font-size: 1.1rem; transition: transform 0.2s; }
    .action-icon:hover { transform: scale(1.2); }

    /* Admin Table Style Ported */
    .admin-style-table { width: 100%; color: var(--text-primary); border-collapse: collapse; }
    .admin-style-table thead { background: rgba(255,255,255,0.02); border-bottom: 2px solid var(--border-color); }
    .admin-style-table th { padding: 16px 20px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; color: var(--text-secondary); letter-spacing: 0.5px; }
    .admin-style-table td { padding: 18px 20px; vertical-align: middle; border-bottom: 1px solid var(--border-color); }
    .admin-style-table tr:hover { background: rgba(255,140,0,0.02); }

    .bg-dark-soft { background: rgba(255,255,255,0.03); }
</style>

@section Scripts {
    <script>
        const orderModal = new bootstrap.Modal(document.getElementById('orderDetailsModal'));
        
        const trackingModal = new bootstrap.Modal(document.getElementById('trackingStatusModal'));

        function showTracking(trackingId) {
            document.getElementById('tLoading').classList.remove('d-none');
            document.getElementById('tContent').classList.add('d-none');
            trackingModal.show();

            fetch(`/Customer/GetOrderDetails?trackingId=${trackingId}`)
                .then(r => r.json())
                .then(data => {
                    if(data.success) {
                        document.getElementById('tTrackingId').textContent = data.trackingId;
                        document.getElementById('tStatus').textContent = data.status.toUpperCase();
                        document.getElementById('tDate').textContent = data.lastUpdate;
                        document.getElementById('tSender').textContent = data.sender;
                        document.getElementById('tReceiver').textContent = data.receiver;
                        document.getElementById('tDest').textContent = data.destination;
                        document.getElementById('tWeight').textContent = data.weight;
                        document.getElementById('tCategory').textContent = data.itemCategory;

                        const timelineContainer = document.getElementById('tTimeline');
                        timelineContainer.innerHTML = '';
                        data.timeline.forEach(ev => {
                            const html = `
                                <div class="t-event-full">
                                    <div class="t-title ${ev.isActive ? 'text-orange' : ''} mb-1">
                                        <i class="bi ${ev.icon} me-1"></i> ${ev.title}
                                    </div>
                                    <div class="t-desc text-secondary mb-2" style="font-size: 0.85rem; line-height: 1.5;">${ev.description}</div>
                                    <div class="t-date text-muted x-small fw-bold opacity-75">${ev.date}</div>
                                </div>
                            `;
                            timelineContainer.insertAdjacentHTML('beforeend', html);
                        });

                        document.getElementById('tLoading').classList.add('d-none');
                        document.getElementById('tContent').classList.remove('d-none');
                    }
                });
        }

        function showOrderDetails(trackingId) {
            document.getElementById('modalLoading').classList.remove('d-none');
            document.getElementById('modalContent').classList.add('d-none');
            document.getElementById('returnReasonBlock').classList.add('d-none');
            orderModal.show();

            fetch(`/Customer/GetOrderDetails?trackingId=${trackingId}`)
                .then(r => r.json())
                .then(data => {
                    if(data.success) {
                        document.getElementById('mTrackingId').textContent = data.trackingId;
                        document.getElementById('mStatus').textContent = data.status.toUpperCase();
                        document.getElementById('mDate').textContent = data.lastUpdate;
                        document.getElementById('mSender').textContent = data.sender;
                        document.getElementById('mReceiver').textContent = data.receiver;
                        document.getElementById('mDest').textContent = data.destination;
                        document.getElementById('mWeight').textContent = data.weight;
                        document.getElementById('mCategory').textContent = data.itemCategory;
                        document.getElementById('mDelivery').textContent = data.deliveryType === 'BranchPickup' ? 'Branch Pickup' : 'Door-to-Door';
                        
                        // Handle Pickup Branch UI
                        const pSection = document.getElementById('pickupSection');
                        if (data.deliveryType === 'BranchPickup' && data.pickupBranch) {
                            document.getElementById('mBranch').textContent = data.pickupBranch;
                            pSection.classList.remove('d-none');
                        } else {
                            pSection.classList.add('d-none');
                        }
                        
                        // Handle Return Reason UI State
                        if(data.status.includes('Return') && data.returnReason) {
                            document.getElementById('mReturnReason').textContent = data.returnReason;
                            document.getElementById('returnReasonBlock').classList.remove('d-none');
                        }


                        document.getElementById('modalLoading').classList.add('d-none');
                        document.getElementById('modalContent').classList.remove('d-none');
                    }
                });
        }
        function confirmDelete(trackingId) {
            const modal = new bootstrap.Modal(document.getElementById('deleteOrderModal'));
            document.getElementById('deleteTrackingIdDisplay').textContent = trackingId;
            document.getElementById('deleteTrackingIdInput').value = trackingId;
            modal.show();
        }
    </script>
}
