@model IEnumerable<SwiftFill.Models.Order>
@{
    ViewData["Title"] = "My Dashboard";
    Layout = "_AdminLayout";
}

<div class="animate-fade-up">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-2">
        <h2 class="fw-bold text-white mb-0">Welcome back, @(User.Identity?.Name?.Split('@')[0] ?? "Partner")</h2>
        <div class="d-md-none small text-secondary">@(DateTime.Now.ToString("MMMM dd, yyyy"))</div>
    </div>

    @if (Model != null && Model.Any(o => o.Status == "Return Notified"))
    {
        <div class="alert alert-warning border border-warning bg-transparent d-flex align-items-center mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
            <div>
                <h6 class="mb-1 fw-bold text-warning">Action Required: Return Notification</h6>
                <span class="x-small text-white-50">One or more of your shipments has been flagged for return by our fulfillment hub. Please check the details.</span>
            </div>
        </div>
    }

    <div class="row g-3 g-md-4 mb-5">
        <div class="col-6 col-md-4">
            <a href="?status=Active" class="text-decoration-none h-100 d-block hover-scale">
                <div class="glass-card p-4 h-100 d-flex justify-content-between align-items-center @(ViewBag.CurrentStatus == "Active" ? "active-border-blue" : "")">
                    <div>
                        <div class="stat-label text-primary fw-bold">ACTIVE</div>
                        <div class="stat-subtitle mt-1">Pending / Picking</div>
                    </div>
                    <div class="stat-value text-white h2 mb-0 fw-bold">@(Model?.Count(o => o.Status != "Delivered" && o.Status != "Returned") ?? 0)</div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4">
            <a href="?status=Delivered" class="text-decoration-none h-100 d-block hover-scale">
                <div class="glass-card p-4 h-100 d-flex justify-content-between align-items-center @(ViewBag.CurrentStatus == "Delivered" ? "active-border-green" : "")">
                    <div>
                        <div class="stat-label text-success fw-bold">DELIVERED</div>
                        <div class="stat-subtitle mt-1">Completed</div>
                    </div>
                    <div class="stat-value text-white h2 mb-0 fw-bold">@(Model?.Count(o => o.Status == "Delivered") ?? 0)</div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-4">
            <a href="?status=Returns" class="text-decoration-none h-100 d-block hover-scale">
                <div class="glass-card p-4 h-100 d-flex justify-content-between align-items-center @(ViewBag.CurrentStatus == "Returns" ? "active-border-orange" : "")">
                    <div>
                        <div class="stat-label text-warning fw-bold">RETURNS</div>
                        <div class="stat-subtitle mt-1">Action Required</div>
                    </div>
                    <div class="stat-value text-white h2 mb-0 fw-bold">@(Model?.Count(o => o.Status.Contains("Return")) ?? 0)</div>
                </div>
            </a>
        </div>
    </div>

    <!-- Integrated Tracking Bar -->
    <div class="mb-5">
        <div class="glass-card p-0 overflow-hidden border border-orange border-opacity-10 shadow-orange-sm" style="background: rgba(255,140,0,0.02); border-radius: 12px;">
            <form onsubmit="event.preventDefault(); showTracking(this.trackingId.value);" class="d-flex align-items-center p-1">
                <div class="d-flex align-items-center px-3 flex-grow-1">
                    <i class="bi bi-upc-scan text-orange me-3"></i>
                    <input type="text" name="trackingId" class="minimal-input w-100 text-white" placeholder="ENTER TRACKING ID TO TRACK..." style="letter-spacing: 2px; border:none !important;" autocomplete="off" required />
                </div>
                <button type="submit" class="btn btn-primary px-4 py-2 fw-bold" style="background: #ff8c00; border-radius: 8px;">TRACK</button>
            </form>
        </div>
    </div>

    <div class="minimal-filter-bar mb-4 d-flex justify-content-between align-items-center">
        <h6 class="text-white mb-0 x-small text-uppercase ls-1">Recent Shipment Registry</h6>
        @if (!string.IsNullOrEmpty(ViewBag.CurrentStatus as string))
        {
            <a href="?" class="text-orange text-decoration-none x-small">View All <i class="bi bi-arrow-right ms-1"></i></a>
        }
    </div>

    <div class="glass-card p-0 overflow-hidden" style="background: rgba(255, 255, 255, 0.01); border: 1px solid rgba(255, 255, 255, 0.05);">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0">
                <thead style="background: rgba(255,140,0,0.03);">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Consignee</th>
                        <th>Destination</th>
                        <th>Volume</th>
                        <th>Status</th>
                        <th class="text-center pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var order in Model)
                        {
                            <tr style="border-bottom: 1px solid rgba(255,255,255,0.02);">
                                <td class="ps-4 py-3"><code class="text-orange">@order.TrackingId</code></td>
                                <td class="py-3 text-white">@order.ReceiverName</td>
                                <td class="py-3 text-secondary small">@order.DestinationRegion</td>
                                <td class="py-3 text-secondary small">@order.Weight kg</td>
                                <td class="py-3">
                                    <span class="badge @(order.Status == "Delivered" ? "border-success text-success" : (order.Status.Contains("Return") ? "border-warning text-warning" : "border-primary text-primary")) border bg-transparent px-2">@order.Status</span>
                                </td>
                                <td class="py-3 text-center pe-4">
                                    <div class="d-flex justify-content-center gap-1">
                                        <button class="btn btn-sm btn-link text-info p-0 action-icon" onclick="showOrderDetails('@order.TrackingId')" title="View Details">
                                            <i class="bi bi-eye-fill"></i>
                                        </button>
                                        @if (order.Status == "Pending" || order.Status == "Picked")
                                        {
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0 action-icon" onclick="confirmDelete('@order.TrackingId')" title="Delete Shipment">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary border-0 opacity-25" title="Cannot delete once processed" disabled>
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-secondary">
                                No active records found in your registry.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Order Details Modal (Enhanced Tracking Design) -->
<div class="modal fade" id="orderDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content glass-modal" style="background: #0a0a0a; border: 1px solid rgba(255,140,0,0.15); border-radius: 24px; overflow: hidden;">
            <div class="modal-header border-0 p-4 pb-0">
                <div class="d-flex align-items-center">
                    <div class="icon-glow-sm me-3">
                        <i class="bi bi-upc-scan text-orange fs-4"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="mTrackingId"></h5>
                        <span class="text-secondary x-small text-uppercase ls-2">SECURED TRACKING LINK</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div id="modalLoading" class="text-center py-5">
                    <div class="spinner-border text-orange" role="status"></div>
                </div>
                <div id="modalContent" class="d-none">
                    <!-- Status Header -->
                    <div class="glass-card mb-4 p-3 border-0 border-start border-orange border-4 d-flex justify-content-between align-items-center" style="background: rgba(255,140,0,0.03);">
                        <div>
                            <span class="text-secondary x-small text-uppercase ls-1 d-block mb-1">Shipping Status</span>
                            <h4 class="text-white fw-bold mb-0" id="mStatus"></h4>
                        </div>
                        <div class="text-end">
                            <span class="text-secondary x-small text-uppercase ls-1 d-block mb-1">Last Update</span>
                            <span class="text-white-50 x-small" id="mDate"></span>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- Shipment Meta -->
                        <div class="col-12">
                            <div class="p-4 rounded-4 h-100" style="background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.05);">
                                <h6 class="text-orange small text-uppercase ls-1 mb-4 fw-bold">Shipment Details</h6>
                                
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="text-secondary x-small d-block mb-1">Sender</label>
                                            <div class="text-white small fw-bold" id="mSender"></div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="text-secondary x-small d-block mb-1">Receiver</label>
                                            <div class="text-white small fw-bold" id="mReceiver"></div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="text-secondary x-small d-block mb-1">Destination</label>
                                            <div class="text-white small fw-bold" id="mDest"></div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="text-secondary x-small d-block mb-1">Service Type</label>
                                            <div class="text-white small fw-bold" id="mDelivery"></div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="text-secondary x-small d-block mb-1">Package Info</label>
                                            <div class="text-white small fw-bold"><span id="mWeight"></span>kg &bull; <span id="mCategory"></span></div>
                                        </div>
                                        <div id="pickupSection" class="mt-3 p-3 rounded-3 d-none" style="background: rgba(255,140,0,0.05);">
                                            <label class="text-orange x-small d-block mb-1 fw-bold">PICKUP HUB</label>
                                            <div class="text-white small fw-bold" id="mBranch"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Issues / Return Section -->
                    <div id="returnReasonBlock" class="mt-4 p-4 rounded-4 d-none" style="background: rgba(220,53,69,0.05); border: 1px solid rgba(220,53,69,0.1);">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-4 me-3"></i>
                            <div>
                                <h6 class="text-danger small text-uppercase ls-1 mb-1 fw-bold">Resolution Required</h6>
                                <p class="text-white-50 x-small mb-0" id="mReturnReason"></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tracking Status Modal (Full Format) -->
<div class="modal fade" id="trackingStatusModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="background: #0d1117; border-radius: 24px; border: 1px solid rgba(255,140,0,0.1) !important;">
            <div class="modal-header border-0 p-4 pb-0">
                <div class="d-flex align-items-center">
                    <div class="icon-glow-sm me-3">
                        <i class="bi bi-geo-alt-fill text-orange fs-4"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="tTrackingId"></h5>
                        <span class="text-secondary x-small text-uppercase ls-2">REAL-TIME SHIPMENT TRACKING</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div id="tLoading" class="text-center py-5">
                    <div class="spinner-border text-orange" role="status"></div>
                </div>
                <div id="tContent" class="d-none">
                    <!-- Status Header -->
                    <div class="glass-card mb-4 p-3 border-0 border-top border-orange border-4" style="background: rgba(255,140,0,0.03);">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-secondary x-small text-uppercase ls-1 d-block mb-1">Status</span>
                                <h3 class="text-orange fw-bold mb-0" id="tStatus"></h3>
                            </div>
                            <div class="text-end">
                                <span class="text-secondary x-small text-uppercase ls-1 d-block mb-1">Last Update</span>
                                <span class="text-white small fw-bold" id="tDate"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <div class="col-md-5">
                            <div class="p-4 rounded-4 h-100" style="background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.05);">
                                <h6 class="text-white-50 small text-uppercase ls-1 mb-4 fw-bold"><i class="bi bi-info-circle me-2"></i> Shipment Info</h6>
                                <div class="mb-3 pb-2 border-bottom border-secondary border-opacity-10">
                                    <label class="text-secondary x-small d-block mb-1">Sender</label>
                                    <div class="text-white small fw-bold" id="tSender"></div>
                                </div>
                                <div class="mb-3 pb-2 border-bottom border-secondary border-opacity-10">
                                    <label class="text-secondary x-small d-block mb-1">Receiver</label>
                                    <div class="text-white small fw-bold" id="tReceiver"></div>
                                </div>
                                <div class="mb-3 pb-2 border-bottom border-secondary border-opacity-10">
                                    <label class="text-secondary x-small d-block mb-1">Destination</label>
                                    <div class="text-white small fw-bold" id="tDest"></div>
                                </div>
                                <div class="mb-0">
                                    <label class="text-secondary x-small d-block mb-1">Package</label>
                                    <div class="text-white small fw-bold"><span id="tWeight"></span>kg &bull; <span id="tCategory"></span></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-7">
                            <div class="p-4 rounded-4 h-100" style="background: rgba(255,255,255,0.01); border: 1px solid rgba(255,255,255,0.05);">
                                <h6 class="text-white-50 small text-uppercase ls-1 mb-4 fw-bold"><i class="bi bi-geo-alt me-2"></i> Tracking Timeline</h6>
                                <div class="timeline-v2-full" id="tTimeline">
                                    <!-- Dynamic Timeline -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteOrderModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content border-0 shadow-lg" style="background: #0a0a0a; border-radius: 16px; border: 1px solid rgba(220,53,69,0.2) !important;">
            <div class="modal-body text-center p-4">
                <div class="display-4 text-danger mb-3"><i class="bi bi-exclamation-octagon"></i></div>
                <h5 class="text-white fw-bold mb-2">Delete Shipment?</h5>
                <p class="text-secondary small mb-4">Are you sure you want to delete shipment <strong id="deleteTrackingIdDisplay" class="text-white"></strong>? This action cannot be undone.</p>
                <form asp-action="DeleteOrder" method="post" id="deleteOrderForm">
                    <input type="hidden" name="trackingId" id="deleteTrackingIdInput" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-dark flex-fill" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger flex-fill fw-bold">Yes, Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .ls-2 { letter-spacing: 2px; }
    .ls-1 { letter-spacing: 1px; }
    .x-small { font-size: 0.75rem; }
    .stat-subtitle { font-size: 0.8rem; color: rgba(255,255,255,0.4) !important; font-weight: 500; }
    .stat-label { font-size: 0.7rem; letter-spacing: 0.5px; opacity: 0.9; }
    .hover-scale { transition: transform 0.2s; }
    .hover-scale:hover { transform: translateY(-3px); }
    
    .glass-card {
        background: #0d1117;
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 16px;
        position: relative;
        overflow: hidden;
    }

    .active-border-orange::before {
        content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px;
        background: #ff8c00; border-radius: 16px 16px 0 0; box-shadow: 0 0 15px rgba(255,140,0,0.2);
    }
    .active-border-blue::before {
        content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px;
        background: #3b82f6; border-radius: 16px 16px 0 0; box-shadow: 0 0 15px rgba(59,130,246,0.2);
    }
    .active-border-green::before {
        content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 3px;
        background: #198754; border-radius: 16px 16px 0 0; box-shadow: 0 0 15px rgba(25,135,84,0.2);
    }

    .action-icon { font-size: 1.15rem; transition: transform 0.2s; }
    .action-icon:hover { transform: scale(1.2); }

    .icon-glow-sm {
        width: 40px; height: 40px;
        background: rgba(255,140,0,0.1);
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        border: 1px solid rgba(255,140,0,0.2);
    }

    /* Full Timeline for Tracking Modal */
    .timeline-v2-full {
        position: relative;
        padding-left: 0;
    }
    .t-event-full {
        position: relative;
        padding-bottom: 20px;
    }
    .t-event-full .t-title { font-weight: 700; font-size: 0.9rem; color: #fff; margin-bottom: 2px; }
    .t-event-full .t-desc { font-size: 0.8rem; color: rgba(255,255,255,0.5); margin-bottom: 4px; }
    .t-event-full .t-date { font-size: 0.75rem; color: rgba(255,255,255,0.3); font-family: monospace; }
</style>

@section Scripts {
    <script>
        const orderModal = new bootstrap.Modal(document.getElementById('orderDetailsModal'));
        
        const trackingModal = new bootstrap.Modal(document.getElementById('trackingStatusModal'));

        function showTracking(trackingId) {
            document.getElementById('tLoading').classList.remove('d-none');
            document.getElementById('tContent').classList.add('d-none');
            trackingModal.show();

            fetch(`/Customer/GetOrderDetails?trackingId=${trackingId}`)
                .then(r => r.json())
                .then(data => {
                    if(data.success) {
                        document.getElementById('tTrackingId').textContent = data.trackingId;
                        document.getElementById('tStatus').textContent = data.status.toUpperCase();
                        document.getElementById('tDate').textContent = data.lastUpdate;
                        document.getElementById('tSender').textContent = data.sender;
                        document.getElementById('tReceiver').textContent = data.receiver;
                        document.getElementById('tDest').textContent = data.destination;
                        document.getElementById('tWeight').textContent = data.weight;
                        document.getElementById('tCategory').textContent = data.itemCategory;

                        const timelineContainer = document.getElementById('tTimeline');
                        timelineContainer.innerHTML = '';
                        data.timeline.forEach(ev => {
                            const html = `
                                <div class="t-event-full">
                                    <div class="t-title ${ev.isActive ? 'text-orange' : ''}">
                                        <i class="bi ${ev.icon} me-1"></i> ${ev.title}
                                    </div>
                                    <div class="t-desc">${ev.description}</div>
                                    <div class="t-date">${ev.date}</div>
                                </div>
                            `;
                            timelineContainer.insertAdjacentHTML('beforeend', html);
                        });

                        document.getElementById('tLoading').classList.add('d-none');
                        document.getElementById('tContent').classList.remove('d-none');
                    }
                });
        }

        function showOrderDetails(trackingId) {
            document.getElementById('modalLoading').classList.remove('d-none');
            document.getElementById('modalContent').classList.add('d-none');
            document.getElementById('returnReasonBlock').classList.add('d-none');
            orderModal.show();

            fetch(`/Customer/GetOrderDetails?trackingId=${trackingId}`)
                .then(r => r.json())
                .then(data => {
                    if(data.success) {
                        document.getElementById('mTrackingId').textContent = data.trackingId;
                        document.getElementById('mStatus').textContent = data.status.toUpperCase();
                        document.getElementById('mDate').textContent = data.lastUpdate;
                        document.getElementById('mSender').textContent = data.sender;
                        document.getElementById('mReceiver').textContent = data.receiver;
                        document.getElementById('mDest').textContent = data.destination;
                        document.getElementById('mWeight').textContent = data.weight;
                        document.getElementById('mCategory').textContent = data.itemCategory;
                        document.getElementById('mDelivery').textContent = data.deliveryType === 'BranchPickup' ? 'Branch Pickup' : 'Door-to-Door';
                        
                        // Handle Pickup Branch UI
                        const pSection = document.getElementById('pickupSection');
                        if (data.deliveryType === 'BranchPickup' && data.pickupBranch) {
                            document.getElementById('mBranch').textContent = data.pickupBranch;
                            pSection.classList.remove('d-none');
                        } else {
                            pSection.classList.add('d-none');
                        }
                        
                        // Handle Return Reason UI State
                        if(data.status.includes('Return') && data.returnReason) {
                            document.getElementById('mReturnReason').textContent = data.returnReason;
                            document.getElementById('returnReasonBlock').classList.remove('d-none');
                        }


                        document.getElementById('modalLoading').classList.add('d-none');
                        document.getElementById('modalContent').classList.remove('d-none');
                    }
                });
        }
        function confirmDelete(trackingId) {
            const modal = new bootstrap.Modal(document.getElementById('deleteOrderModal'));
            document.getElementById('deleteTrackingIdDisplay').textContent = trackingId;
            document.getElementById('deleteTrackingIdInput').value = trackingId;
            modal.show();
        }
    </script>
}
