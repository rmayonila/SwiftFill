@model IEnumerable<SwiftFill.Models.ShippingRate>
@{
    ViewData["Title"] = "Shipping Rate Management — SwiftFill";
    Layout = "_AdminLayout";
}

<div class="animate-fade-up">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-theme pb-3">
        <h1 class="fw-bold fs-3 mt-2 mb-0 text-primary">
            <i class="bi bi-tags-fill me-3 text-warning"></i> Shipping Rate Management
        </h1>
        <p class="text-secondary mt-2 mb-0 small">
            Configure the destination-based pricing rules. Changes will immediately affect new bookings and weight edits.
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert border-success border-opacity-50 text-success bg-theme-soft rounded-3 mb-4">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4">
        @foreach (var rate in Model.OrderBy(r => r.DestinationRegion))
        {
            <div class="col-md-6">
                <div class="card glass-card border-0 h-100" style="border: 1px solid var(--border-color) !important; border-radius: 12px;">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="text-primary fw-bold m-0"><i class="bi bi-geo-alt-fill text-warning me-2"></i>@rate.DestinationRegion</h5>
                            <span class="text-secondary x-small">Last updated: @rate.UpdatedAt.ToString("MMM dd, yyyy")</span>
                        </div>
                        
                        <form asp-action="UpdateShippingRate" method="post">
                            <input type="hidden" name="DestinationRegion" value="@rate.DestinationRegion" />
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="text-secondary small mb-2 fw-semibold">Base Rate (₱)</label>
                                    <input type="number" name="BaseRate" value="@rate.BaseRate" class="form-control bg-theme border-theme text-primary shadow-none" required step="0.01" style="border-radius: 8px;" />
                                </div>
                                <div class="col-md-4">
                                    <label class="text-secondary small mb-2 fw-semibold">Price / Kg (₱)</label>
                                    <input type="number" name="PricePerKg" value="@rate.PricePerKg" class="form-control bg-theme border-theme text-primary shadow-none" required step="0.01" style="border-radius: 8px;" />
                                </div>
                                <div class="col-md-4">
                                    <label class="text-secondary small mb-2 fw-semibold">Zone Surcharge (₱)</label>
                                    <input type="number" name="ZoneSurcharge" value="@rate.ZoneSurcharge" class="form-control bg-theme border-theme text-primary shadow-none" required step="0.01" style="border-radius: 8px;" />
                                </div>
                            </div>
                            <div class="mt-4 pt-3 border-top border-theme border-opacity-10 d-flex justify-content-between align-items-center">
                                <div class="text-secondary" style="font-size: 0.75rem;">
                                    <i class="bi bi-info-circle me-1"></i> Calculation: Base + (Weight * Price/Kg) + Surcharge
                                </div>
                                <button type="submit" class="btn btn-warning fw-bold px-4 py-2" style="border-radius: 8px; color: #000;">
                                    <i class="bi bi-save me-1"></i> Update Rates
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .glass-card {
        background: var(--bg-secondary);
        transition: all 0.3s ease;
    }
    .glass-card:hover { 
        border-color: var(--swift-orange) !important; 
        box-shadow: 0 8px 25px rgba(0,0,0,0.1); 
        transform: translateY(-3px); 
    }
    [data-theme="dark"] .glass-card:hover {
        box-shadow: 0 8px 25px rgba(0,0,0,0.5);
    }
</style>
