@{
    ViewData["Title"] = "Verify Code - SwiftFill";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" />
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <style>
        body {
            background-color: var(--bg-color);
            font-family: 'Inter', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            color: var(--text-primary);
        }

        .login-wrapper {
            width: 100%;
            max-width: 450px;
            padding: 20px;
        }

        .login-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 40px;
            box-shadow: var(--card-shadow);
        }

        .form-label {
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 8px;
        }

        .input-group-text {
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            border-right: none;
            color: var(--text-secondary);
        }

        .form-control {
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            font-size: 1.5rem;
            padding: 12px;
            text-align: center;
            letter-spacing: 5px;
            font-weight: 700;
        }

        .form-control:focus {
            background: var(--bg-color);
            color: var(--text-primary);
            box-shadow: none;
            border-color: #ff8c00;
        }

        .btn-signin {
            background: #ff8c00;
            color: #000;
            font-weight: 600;
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: none;
            margin-top: 20px;
            transition: 0.2s;
        }

        .btn-signin:hover {
            background: #fc9417;
            transform: translateY(-1px);
        }

        .back-link {
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.9rem;
            display: block;
            text-align: center;
            margin-top: 30px;
            transition: 0.2s;
        }

        .back-link:hover {
            color: var(--text-primary);
        }
    </style>
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body>

    <div class="login-wrapper animate-fade-up">
        <div class="brand-logo" style="margin-bottom: 24px;">
            <img src="~/images/logo.png" class="auth-logo" alt="SwiftFill" />
            <span style="font-size: 2rem; font-weight: 800; color: var(--text-primary); font-family: 'Sora', sans-serif; letter-spacing: -0.5px;">SwiftFill</span>
        </div>

        <div class="login-card">
            <div class="text-center mb-4">
                <i class="bi bi-shield-check text-orange" style="font-size: 3rem; color: #ff8c00;"></i>
                <h3 class="fw-bold mt-2 mb-2">Verify Code</h3>
                <p class="text-secondary" style="font-size:0.95rem;">Please enter the 6-digit code sent to your email.</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger mb-4 text-center" style="font-size: 0.9rem;">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                </div>
            }

            <form method="post" action="/Account/VerifyCodeAction">
                
                <div class="mb-3">
                    <div class="input-group">
                        <input type="text" name="code" class="form-control" placeholder="000000" maxlength="6" required autocomplete="off">
                    </div>
                </div>

                <button type="submit" class="btn-signin">Verify Code</button>
            </form>

        </div>

        <a href="/Account/ForgotPassword" class="back-link">&larr; Back to email entry</a>
    </div>

</body>
</html>
