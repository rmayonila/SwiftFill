@{
    ViewData["Title"] = "Verify Code - SwiftFill";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body {
            background-color: #0d1117;
            font-family: 'Inter', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            color: #ffffff;
        }

        .login-wrapper {
            width: 100%;
            max-width: 450px;
            padding: 20px;
        }

        .login-card {
            background: #161b22;
            border: 1px solid #30363d;
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .form-label {
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 8px;
        }

        .input-group-text {
            background: #0d1117;
            border: 1px solid #30363d;
            border-right: none;
            color: #8b949e;
        }

        .form-control {
            background: #0d1117;
            border: 1px solid #30363d;
            color: #ffffff;
            font-size: 1.5rem;
            padding: 12px;
            text-align: center;
            letter-spacing: 5px;
            font-weight: 700;
        }

        .form-control:focus {
            background: #0d1117;
            color: #ffffff;
            box-shadow: none;
            border-color: #ff8c00;
        }

        .btn-signin {
            background: #ff8c00;
            color: #000;
            font-weight: 600;
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: none;
            margin-top: 20px;
            transition: 0.2s;
        }

        .btn-signin:hover {
            background: #fc9417;
            transform: translateY(-1px);
        }

        .back-link {
            color: #8b949e;
            text-decoration: none;
            font-size: 0.9rem;
            display: block;
            text-align: center;
            margin-top: 30px;
            transition: 0.2s;
        }

        .back-link:hover {
            color: #ffffff;
        }
    </style>
</head>
<body>

    <div class="login-wrapper animate-fade-up">
        <div class="login-card">
            <div class="text-center mb-4">
                <i class="bi bi-shield-check text-orange" style="font-size: 3rem; color: #ff8c00;"></i>
                <h3 class="fw-bold mt-2 mb-2">Verify Code</h3>
                <p class="text-secondary" style="font-size:0.95rem;">Please enter the 6-digit code sent to your email.</p>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" style="background:#2d1b1e; color:#ff6b6b; border:1px solid #4a2121; text-align:center;">
                    <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
                </div>
            }

            <form method="post" action="/Account/VerifyCodeAction">
                
                <div class="mb-3">
                    <div class="input-group">
                        <input type="text" name="code" class="form-control" placeholder="000000" maxlength="6" required autocomplete="off">
                    </div>
                </div>

                <button type="submit" class="btn-signin">Verify Code</button>
            </form>

        </div>

        <a href="/Account/ForgotPassword" class="back-link">&larr; Back to email entry</a>
    </div>

</body>
</html>
