@model IEnumerable<SwiftFill.Models.Payment>
@{
    ViewData["Title"] = "Cash Remittance";
    Layout = "_RiderLayout";
}

<style>
    .glass-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        position: relative;
        overflow: hidden;
    }
    .stat-label { font-size: 0.7rem; letter-spacing: 0.5px; opacity: 0.9; }
    .stat-subtitle { font-size: 0.8rem; color: #3b82f6 !important; font-weight: 500; }
    .stat-value { font-family: 'Sora', sans-serif; font-weight: 800; }

    .active-border-orange::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: #ff8c00;
        border-radius: 16px 16px 0 0;
        box-shadow: 0 0 15px rgba(255,140,0,0.2);
    }

    .remittance-table {
        width: 100%;
        color: var(--text-primary);
        border-collapse: collapse;
    }
    .remittance-table thead {
        background: rgba(255, 140, 0, 0.03);
    }
    .remittance-table th {
        padding: 14px 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--text-secondary);
        border-bottom: 1px solid var(--border-color);
    }
    .remittance-table td {
        padding: 16px 20px;
        vertical-align: middle;
        border-bottom: 1px solid var(--border-color);
    }
    .remittance-table tr:hover {
        background: var(--card-bg-hover);
    }
    .btn-orange {
        background: #ff8c00 !important;
        color: #000 !important;
        border: none !important;
        transition: all 0.2s ease;
    }
    .btn-orange:hover {
        background: #ff9d26 !important;
        color: #000 !important;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(255, 140, 0, 0.3);
    }
</style>

<div class="animate-fade-up">
    <!-- Dashboard Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold fs-3 mt-2 mb-0 text-primary">
            <i class="bi bi-wallet2 text-orange me-2"></i> Cash Hub
        </h2>
        <div class="text-secondary small">Manage COD collections and remittances</div>
    </div>

    <!-- KPI Cards — Admin-style responsive grid -->
    <div class="row g-3 mb-5">
        <div class="col-6 col-md-4">
            <div class="glass-card active-border-orange p-4 h-100 d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label text-orange fw-bold text-uppercase">Collections</div>
                    <div class="stat-subtitle mt-1 text-secondary">Total Pending</div>
                </div>
                <div class="stat-value text-primary display-6 fw-bold mb-0">@Model.Count()</div>
            </div>
        </div>
        <div class="col-6 col-md-4">
            <div class="glass-card p-4 h-100 d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label text-info fw-bold text-uppercase">Cash on Hand</div>
                    <div class="stat-subtitle mt-1 text-secondary">To Remit</div>
                </div>
                <div class="stat-value text-primary fw-bold mb-0" style="font-size: 1.6rem;">₱@Model.Sum(p => p.Amount).ToString("N0")</div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="glass-card p-4 h-100 d-flex flex-column justify-content-center align-items-center text-center">
                @if (Model.Any())
                {
                    <form asp-action="MarkAsRemitted" method="post" class="w-100">
                        <button type="submit" class="btn btn-orange w-100 fw-bold rounded-pill shadow-sm py-2" onclick="return confirm('Confirm Remittance: Are you at the hub and have handed over the cash?')">
                            <i class="bi bi-qr-code me-2"></i> DONE REMIT
                        </button>
                    </form>
                }
                else
                {
                    <button class="btn btn-secondary w-100 fw-bold rounded-pill shadow-sm py-2" disabled>
                        <i class="bi bi-check2-all me-2"></i> ALL REMITTED
                    </button>
                }
                <div class="text-secondary mt-2" style="font-size: 0.75rem;">Status: <span class="@(Model.Any() ? "text-success" : "text-secondary") fw-bold">@(Model.Any() ? "Active" : "Cleared")</span></div>
            </div>
        </div>
    </div>

    <!-- Remittance Manifest Table -->
    <h5 class="text-primary fw-bold mb-3 text-uppercase ls-1">
        <i class="bi bi-list-ul text-orange me-2"></i> CASH REMITTANCE MANIFEST
    </h5>
    
    <div class="glass-card p-0 overflow-hidden border-secondary border-opacity-10">
        <div class="table-responsive">
            <table class="remittance-table mb-0">
                <thead>
                    <tr>
                        <th style="min-width: 150px;">Tracking ID</th>
                        <th style="min-width: 180px;">Customer</th>
                        <th style="min-width: 120px;">Amount</th>
                        <th style="min-width: 140px;">Paid At</th>
                        <th style="min-width: 120px;" class="text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <code class="text-orange fw-bold">#@payment.TrackingId</code>
                            </td>
                            <td>
                                <div class="text-primary fw-bold">@payment.Order?.ReceiverName</div>
                                <div class="text-secondary x-small">COD Payment</div>
                            </td>
                            <td>
                                <div class="text-primary fw-bold">₱@payment.Amount.ToString("N2")</div>
                            </td>
                            <td>
                                <div class="text-secondary small">@payment.PaidAt?.ToString("hh:mm tt")</div>
                                <div class="text-secondary x-small">@payment.PaidAt?.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td class="text-end pe-4">
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2">
                                    <i class="bi bi-check2-circle me-1"></i> COLLECTED
                                </span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-secondary">
                                <i class="bi bi-cash-stack display-4 d-block mb-3 opacity-25"></i>
                                No pending COD collections found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>