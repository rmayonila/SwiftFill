@model IEnumerable<SwiftFill.Models.Order>
@{
    Layout = "_RiderLayout";
    ViewData["Title"] = "History";
}

<style>
    .glass-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        position: relative;
        overflow: hidden;
    }
    .stat-label { font-size: 0.7rem; letter-spacing: 0.5px; opacity: 0.9; }
    .stat-subtitle { font-size: 0.8rem; color: #3b82f6 !important; font-weight: 500; }
    .stat-value { font-family: 'Sora', sans-serif; font-weight: 800; }

    .active-border-orange::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
        background: #ff8c00;
        border-radius: 16px 16px 0 0;
        box-shadow: 0 0 15px rgba(255,140,0,0.2);
    }

    .history-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        transition: all 0.2s;
    }
    .history-card:hover { 
        border-color: #ff8c00; 
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(255, 140, 0, 0.1);
    }
</style>

<div class="animate-fade-up">
    <!-- Dashboard Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-2 mb-4">
        <h2 class="fw-bold fs-3 mt-2 mb-0 text-primary">
            <i class="bi bi-clock-history text-orange me-2"></i> Delivery Log
        </h2>
        <div class="text-secondary small">History of completed assignments</div>
    </div>

    <!-- KPI Cards — Admin-style responsive grid -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-6">
            <div class="glass-card active-border-orange p-4 h-100 d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label text-success fw-bold text-uppercase">Delivered</div>
                    <div class="stat-subtitle mt-1 text-secondary">Successfully Completed</div>
                </div>
                <div class="stat-value text-primary display-6 fw-bold mb-0">@Model.Count(o => o.Status == "Delivered")</div>
            </div>
        </div>
        <div class="col-6 col-md-6">
            <div class="glass-card p-4 h-100 d-flex justify-content-between align-items-center">
                <div>
                    <div class="stat-label text-danger fw-bold text-uppercase">Returned</div>
                    <div class="stat-subtitle mt-1 text-secondary">Failed or Rejected</div>
                </div>
                <div class="stat-value text-primary display-6 fw-bold mb-0">@Model.Count(o => o.Status == "Returned")</div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var order in Model)
        {
            <div class="col-12">
                <div class="history-card p-3 d-flex align-items-center justify-content-between" onclick="viewOrderDetails('@order.TrackingId')" style="cursor: pointer;">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" 
                             style="width: 45px; height: 45px; background: @(order.Status == "Delivered" ? "rgba(25, 135, 84, 0.1)" : "rgba(255, 255, 255, 0.05)");">
                            <i class="bi @(order.Status == "Delivered" ? "bi-check-lg text-success" : "bi-arrow-return-left text-secondary") fs-4"></i>
                        </div>
                        <div>
                            <div class="text-primary fw-bold">#@order.TrackingId</div>
                            <div class="text-secondary smaller">@order.ReceiverName • @order.UpdatedAt.ToString("MMM dd")</div>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="text-primary fw-bold">₱@order.Payment?.Amount.ToString("N0")</div>
                        <div class="text-secondary" style="font-size: 0.65rem;">@order.Payment?.Method</div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<div class="modal fade" id="orderDetailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary" style="border-radius: 20px;">
            <div class="modal-header border-0">
                <h5 class="modal-title text-white fw-bold">Receipt Details</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalContent">
                <!-- Data loaded via JS -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewOrderDetails(trackingId) {
            const modal = new bootstrap.Modal(document.getElementById('orderDetailModal'));
            modal.show();
            $('#modalContent').html('<div class="text-center py-4"><div class="spinner-border text-orange"></div></div>');

            $.get(`/Rider/GetOrderDetails?trackingId=${trackingId}`, function(data) {
                let statusBadge = data.status === "Delivered" ? "text-success" : "text-danger";
                let html = `
                    <div class="text-center mb-4">
                        <div class="text-orange fw-bold h4">#${data.trackingId}</div>
                        <div class="small ${statusBadge} text-uppercase fw-bold">${data.status}</div>
                    </div>
                    <div class="glass-card p-3 mb-3 border-0" style="background: rgba(255, 255, 255, 0.03);">
                        <div class="text-secondary smaller text-uppercase fw-bold mb-1">Customer</div>
                        <div class="text-white fw-bold">${data.receiverName}</div>
                        <div class="text-secondary small">${data.receiverAddress}</div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <div class="glass-card p-2 text-center border-0" style="background: rgba(255, 255, 255, 0.03);">
                                <label class="text-secondary smaller d-block">Attempts</label>
                                <span class="text-white fw-bold">${data.attempts}</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="glass-card p-2 text-center border-0" style="background: rgba(255, 255, 255, 0.03);">
                                <label class="text-secondary smaller d-block">${data.paymentMethod === 'COD' ? 'COD Amount' : 'Paid Amount'}</label>
                                <div class="text-orange fw-bold">₱${data.amount}</div>
                                ${data.paymentMethod !== 'COD' ? `<div class="text-secondary" style="font-size: 0.65rem;">${data.paymentMethod}</div>` : ''}
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="text-secondary smaller text-uppercase fw-bold mb-1">Proof Provided</label>
                        <div class="rounded-3 overflow-hidden border border-secondary border-opacity-10">
                            ${data.photo ? `<img src="${data.photo}" class="img-fluid w-100" />` : 
                            `<div class="p-4 text-center text-secondary small"><i class="bi bi-camera-slash-fill d-block fs-3 mb-2"></i> No photo found</div>`}
                        </div>
                    </div>
                `;
                $('#modalContent').html(html);
            });
        }
    </script>
}