@model IEnumerable<SwiftFill.Models.UserManagementViewModel>

@{
    ViewData["Title"] = "Users & Roles - SwiftFill";
    Layout = "_AdminLayout";
}

<div class="animate-fade-up">

    <!-- Top Header Profile Area -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-theme pb-3">
        <div>
            <h1 class="fw-bold fs-3 mt-2 mb-0 text-primary"><i class="bi bi-people-fill text-orange me-3"></i> Users & Roles</h1>
            <p class="text-secondary mt-1" style="font-size: 1rem;">Manage system access, identities, and permissions.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge border border-success text-success bg-success bg-opacity-10 px-3 py-2" style="border-radius: 8px;">
                <i class="bi bi-people-fill me-2"></i>Total Users: @Model.Count()
            </span>
        </div>
    </div>

    <!-- Search & Filter Bar (Reference-Matched) -->
    <div class="d-flex justify-content-between align-items-center mb-4 gap-3 bg-theme-soft p-2 rounded-3" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
        <div class="d-flex align-items-center flex-grow-1 gap-3">
            <form method="get" class="d-flex align-items-center flex-grow-1">
                <div class="search-wrapper flex-grow-1" style="max-width: 400px;">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="minimal-input w-100 text-primary bg-transparent" 
                           placeholder="Search email, first name, or last name...">
                </div>
            </form>
        </div>

        <div class="d-flex align-items-center gap-4">
            <form method="get" class="d-flex align-items-center gap-3">
                <select name="role" class="minimal-input text-primary" style="width: 150px; background: transparent; border: none;" onchange="this.form.submit()">
                    <option value="">All Roles</option>
                    @foreach (var r in (ViewBag.AllRoles as List<string>) ?? new List<string> { "Admin", "WarehouseStaff", "DeliveryRider", "SuperAdmin" })
                    {
                        <option value="@r" selected="@(ViewBag.Role == r)">@r</option>
                    }
                </select>
            </form>
            <button class="btn btn-warning fw-bold px-4 py-2 shadow-sm d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#registerUserModal" style="border-radius: 8px; color: #000; font-size: 0.85rem;">
                <i class="bi bi-person-plus-fill me-2"></i>Add User
            </button>
        </div>
    </div>

    <!-- User Management Table (Glass-Card) -->
    <div class="glass-card p-0 overflow-hidden">
        <div class="card-header bg-transparent border-bottom border-theme py-3 px-4 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold d-flex align-items-center text-primary">
                <i class="bi bi-people-fill text-orange me-3" style="font-size: 1.2rem;"></i> 
                All System Users
            </h6>
        </div>
        
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead style="background: rgba(255,140,0,0.03);">
                        <tr>
                            <th class="ps-4 py-3 text-secondary fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">User Identity</th>
                            <th class="py-3 text-secondary fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Username</th>
                            <th class="py-3 text-secondary fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Role & Permissions</th>
                            <th class="py-3 text-secondary fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Hub Assignment</th>
                            <th class="py-3 text-secondary fw-semibold text-uppercase" style="font-size: 0.75rem; letter-spacing: 1px;">Status</th>
                            <th class="pe-4 py-3 text-secondary fw-semibold text-uppercase text-end" style="font-size: 0.75rem; letter-spacing: 1px;">Controls</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var user = item.User;
                            <tr style="border-bottom: 1px solid var(--border-color);">
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex justify-content-center align-items-center me-3 flex-shrink-0" style="width: 35px; height: 35px; background: rgba(255, 140, 0, 0.15); color: #ff8c00; font-weight:bold;">
                                            @((!string.IsNullOrEmpty(user.FirstName) ? user.FirstName.Substring(0,1).ToUpper() : "U"))
                                        </div>
                                        <div>
                                            <div class="fw-bold text-primary mb-1" style="font-size: 0.95rem;">@user.FirstName @user.LastName</div>
                                            <div class="text-secondary" style="font-size: 0.75rem;">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                
                                <td class="py-3">
                                    <code class="text-orange">@user.UserName</code>
                                </td>
                                
                                <td class="py-3">
                                    <span class="badge border border-orange text-orange bg-theme-soft mb-1 role-badge" style="padding: 5px 10px;">@item.Role</span>
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach(var claim in item.Claims)
                                        {
                                            <span class="text-secondary" style="font-size: 0.65rem; border: 1px solid var(--border-color); padding: 1px 4px; border-radius: 4px;">@claim</span>
                                        }
                                        @if(!item.Claims.Any()){ <span class="text-muted smaller">No specific claims</span> }
                                    </div>
                                </td>

                                <td class="py-3">
                                    <div class="d-flex align-items-center text-secondary small">
                                        <i class="bi bi-geo-alt-fill text-orange me-2"></i>
                                        @(user.Hub ?? "No Hub Assigned")
                                    </div>
                                </td>
                                
                                <td class="py-3">
                                    @if(user.LockoutEnd != null && user.LockoutEnd > DateTimeOffset.UtcNow) 
                                    { 
                                        <span class="badge border border-danger text-danger bg-danger bg-opacity-10" style="padding: 5px 10px;">
                                            <i class="bi bi-person-x-fill me-1"></i> Suspended
                                        </span> 
                                    }
                                    else if(user.EmailConfirmed) 
                                    { 
                                        <span class="badge border border-success text-success bg-success bg-opacity-10" style="padding: 5px 10px;">
                                            <i class="bi bi-check-circle-fill me-1"></i> Active
                                        </span> 
                                    }
                                    else 
                                    { 
                                        <span class="badge border border-warning text-warning bg-warning bg-opacity-10" style="padding: 5px 10px;">
                                            <i class="bi bi-exclamation-circle-fill me-1"></i> Pending
                                        </span> 
                                    }
                                </td>
                                
                                <td class="pe-4 py-3 text-end">
                                    <div class="btn-group">
                                        <button class="btn btn-sm btn-theme" title="Manage Roles" 
                                                onclick="openManageRolesModal('@user.Id', '@user.FirstName @user.LastName', '@item.Role', '@string.Join(",", item.Claims)', '@(user.Hub ?? "None")')">
                                            <i class="bi bi-shield-lock"></i>
                                        </button>
                                        <button class="btn btn-sm btn-theme mx-1" title="Edit Profile" 
                                                onclick="openEditProfileModal('@user.Id', '@user.UserName', '@user.FirstName', '@user.LastName', '@user.PhoneNumber', '@user.Hub')">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <form asp-action="SuspendUser" method="post" class="d-inline">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-sm btn-theme border-danger text-danger" title="@(user.LockoutEnd > DateTimeOffset.UtcNow ? "Reactivate" : "Suspend")">
                                                <i class="bi bi-person-x"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                        
                        @if(!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    No underlying users found securely in the database.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Pagination (Reference-Matched) -->
    @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
    {
        <div class="mt-4">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link bg-theme border-0 text-secondary px-3" href="?search=@ViewBag.Search&role=@ViewBag.Role&page=@(ViewBag.CurrentPage - 1)">Previous</a>
                </li>
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link @(i == ViewBag.CurrentPage ? "bg-orange border-0" : "bg-theme border-0 text-secondary") mx-1 rounded" href="?search=@ViewBag.Search&role=@ViewBag.Role&page=@i">@i</a>
                    </li>
                }
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link bg-theme border-0 text-secondary px-3" href="?search=@ViewBag.Search&role=@ViewBag.Role&page=@(ViewBag.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>

<!-- Register New User Modal -->
<div class="modal fade" id="registerUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-primary" style="background: var(--modal-bg); backdrop-filter: blur(10px); border: 1px solid var(--border-color); border-radius: 12px;">
            <div class="modal-header border-theme">
                <h5 class="modal-title fw-bold"><i class="bi bi-person-plus-fill text-warning me-2"></i> Register New User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="RegisterUser" method="post">
                <div class="modal-body">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-secondary small">First Name</label>
                            <input type="text" name="FirstName" class="form-control bg-theme text-primary border-theme shadow-none" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-secondary small">Last Name</label>
                            <input type="text" name="LastName" class="form-control bg-theme text-primary border-theme shadow-none" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Username</label>
                        <input type="text" name="UserName" class="form-control bg-theme text-primary border-theme shadow-none" placeholder="Enter username" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Email Address</label>
                        <input type="email" name="Email" class="form-control bg-theme text-primary border-theme shadow-none" placeholder="Enter email" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Password</label>
                        <div class="position-relative">
                            <input type="password" name="Password" id="regPassword" class="form-control bg-theme text-primary border-theme shadow-none w-100" placeholder="Enter password" required>
                            <span class="position-absolute end-0 top-50 translate-middle-y me-3 text-secondary" style="cursor: pointer; z-index: 10;" onclick="togglePassword('regPassword', this)">
                                <i class="bi bi-eye"></i>
                            </span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Phone Number</label>
                        <input type="text" name="PhoneNumber" class="form-control bg-theme text-primary border-theme shadow-none" placeholder="09123456789" required pattern="^\d{11}$" title="Phone number must be exactly 11 digits">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small">Assign Primary Role</label>
                        <select name="Role" id="reg_role" class="form-select bg-theme text-primary border-theme shadow-none" onchange="updateDefaultPermissions(this.value)">
                            <option value="">Select Role</option>
                            @foreach (var r in (ViewBag.AllRoles as List<string>) ?? new List<string>())
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-secondary small">ASSIGN HUB</label>
                        <select name="Hub" class="form-select bg-theme text-primary border-theme shadow-none">
                            <option value="">No Hub Assignment</option>
                            @foreach(var hub in (ViewBag.AllHubNames as List<string>) ?? SwiftFill.Models.HubRegistry.Names) {
                                <option value="@hub">@hub</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-theme">
                    <button type="button" class="btn btn-dark" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning fw-bold text-dark">Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Manage Roles & Claims Modal -->
<div class="modal fade" id="manageRolesModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-primary" style="background: var(--modal-bg); border: 1px solid var(--border-color); border-radius: 12px;">
            <div class="modal-header border-theme">
                <h5 class="modal-title fw-bold"><i class="bi bi-shield-lock text-info me-2"></i> Manage Permissions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateRoles" method="post">
                <div class="modal-body text-center py-4">
                    <input type="hidden" name="userId" id="manage_userId" />
                    <div class="mb-4">
                        <p class="mb-1">Adjusting permissions for <strong id="manage_userName" class="text-warning">User</strong></p>
                        <p class="small text-secondary mb-0">Managing Access for Hub: <span id="manage_hubDisplay" class="text-info fw-bold">None</span></p>
                    </div>
                    
                    <div class="text-start px-4">
                        <label class="form-label text-secondary small">Primary Role</label>
                        <select name="role" id="manage_role" class="form-select bg-theme border-theme text-primary mb-3">
                            @foreach (var r in (ViewBag.AllRoles as List<string>) ?? new List<string>())
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-theme">
                    <button type="button" class="btn btn-dark" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info text-dark fw-bold">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Profile Modal -->
<div class="modal fade" id="editProfileModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-primary" style="background: var(--modal-bg); border: 1px solid var(--border-color); border-radius: 12px;">
            <div class="modal-header border-theme">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-success me-2"></i> Edit Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateProfile" method="post">
                <div class="modal-body py-4">
                    <input type="hidden" name="userId" id="edit_userId" />
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label text-secondary small">First Name</label>
                            <input type="text" name="firstName" id="edit_firstName" class="form-control bg-theme border-theme text-primary" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-secondary small">Last Name</label>
                            <input type="text" name="lastName" id="edit_lastName" class="form-control bg-theme border-theme text-primary" required>
                        </div>
                    </div>
                    <label class="form-label text-secondary small">Username</label>
                    <input type="text" name="userName" id="edit_userName" class="form-control bg-theme border-theme text-primary mb-3" required>
                    
                    <label class="form-label text-secondary small">Phone Number</label>
                    <input type="text" name="phoneNumber" id="edit_phoneNumber" class="form-control bg-theme border-theme text-primary mb-3" placeholder="09123456789" required pattern="^\d{11}$" title="Phone number must be exactly 11 digits">
                    
                    <label class="form-label text-secondary small">ASSIGN HUB</label>
                    <select name="hub" id="edit_hub" class="form-select bg-theme border-theme text-primary">
                        <option value="">None</option>
                        @foreach(var hub in (ViewBag.AllHubNames as List<string>) ?? SwiftFill.Models.HubRegistry.Names)
                        {
                            <option value="@hub">@hub</option>
                        }
                    </select>

                    <div class="mt-4 pt-3 border-top border-theme">
                        <label class="form-label text-secondary small">Current Password (Encrypted)</label>
                        <input type="text" class="form-control bg-theme border-theme text-secondary mb-3" value="********" readonly>
                        
                        <label class="form-label text-warning small fw-bold">NEW PASSWORD</label>
                        <div class="position-relative">
                            <input type="password" name="newPassword" id="editNewPassword" class="form-control minimal-input border-orange text-primary w-100" placeholder="Enter new password to reset">
                            <span class="position-absolute end-0 top-50 translate-middle-y me-3 text-secondary" style="cursor: pointer; z-index: 10;" onclick="togglePassword('editNewPassword', this)">
                                <i class="bi bi-eye"></i>
                            </span>
                        </div>
                        <div class="form-text text-muted smaller">Leave blank to keep existing password.</div>
                    </div>
                </div>
                <div class="modal-footer border-theme">
                    <button type="button" class="btn btn-dark px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success fw-bold px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .hover-white:hover {
        color: #ffffff !important;
        background: #30363d !important;
    }
    .fs-xs { font-size: 0.8rem; }
    
    [data-theme="dark"] .role-badge {
        border-color: #000000 !important;
        background-color: #ff8c00 !important;
        color: #000000 !important;
        font-weight: 700;
    }
    
    .btn-check:checked + .btn-outline-secondary {
        background-color: #ff8c00;
        border-color: #ff8c00;
        color: #000;
        font-weight: 600;
    }
</style>

<script>
    function updateDefaultPermissions(role) {
        // Reset all checkboxes in the registration modal
        const ids = ['p_s_v', 'p_s_e', 'p_i_v', 'p_i_e', 'p_f_v', 'p_f_e', 'p_u_e', 'p_h_e', 'p_d_v', 'p_d_e'];
        ids.forEach(id => {
            const el = document.getElementById(id);
            if (el) el.checked = false;
        });

        // Define default permissions per role
        const mapping = {
            'Admin': ['Permissions.Shipments.View', 'Permissions.Shipments.Edit', 'Permissions.Shipments.Create', 'Permissions.Inventory.View', 'Permissions.Inventory.Edit', 'Permissions.Finance.View'],
            'WarehouseStaff': ['Permissions.Shipments.View', 'Permissions.Shipments.Edit', 'Permissions.Inventory.View', 'Permissions.Inventory.Edit'],
            'DeliveryRider': ['Permissions.Shipments.View', 'Permissions.Delivery.View', 'Permissions.Delivery.Edit'],
            'Customer': []
        };

        const perms = mapping[role] || [];
        ids.forEach(id => {
            const el = document.getElementById(id);
            if (el && perms.includes(el.value)) {
                el.checked = true;
            }
        });
    }

    function openManageRolesModal(id, name, role, claims, hub) {
        document.getElementById('manage_userId').value = id;
        document.getElementById('manage_userName').textContent = name;
        document.getElementById('manage_role').value = role;
        document.getElementById('manage_hubDisplay').textContent = hub || 'None';
        
        new bootstrap.Modal(document.getElementById('manageRolesModal')).show();
    }

    function openEditProfileModal(id, username, first, last, phone, hub) {
        document.getElementById('edit_userId').value = id;
        document.getElementById('edit_userName').value = username;
        document.getElementById('edit_firstName').value = first;
        document.getElementById('edit_lastName').value = last;
        document.getElementById('edit_phoneNumber').value = phone;
        document.getElementById('edit_hub').value = hub;
        
        new bootstrap.Modal(document.getElementById('editProfileModal')).show();
    }

    function togglePassword(inputId, iconElement) {
        const input = document.getElementById(inputId);
        const icon = iconElement.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('bi-eye');
            icon.classList.add('bi-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('bi-eye-slash');
            icon.classList.add('bi-eye');
        }
    }
</script>
