@model IEnumerable<SwiftFill.Services.AuditLogEntry>
@{
    ViewData["Title"] = "Security Logs";
    Layout = "_AdminLayout";
}

<div class="animate-fade-up">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-theme pb-3">
        <div>
            <h1 class="fw-bold fs-3 mt-2 mb-0 text-primary"><i class="bi bi-shield-lock-fill text-danger me-3"></i> Security Logs</h1>
            <p class="text-secondary mt-1" style="font-size: 1rem;">Login attempts, access events, hub check-ins, and policy changes.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge border border-danger text-danger bg-danger bg-opacity-10 px-3 py-2" style="border-radius: 8px;">
                <i class="bi bi-shield-lock-fill me-2"></i>Total Events: @Model.Count()
            </span>
        </div>
    </div>

    <!-- Search & Filter Bar (Reference-Matched) -->
    <div class="d-flex justify-content-between align-items-center mb-4 gap-3 bg-theme-soft p-2 rounded-3" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
        <div class="d-flex align-items-center flex-grow-1 gap-3">
            <form method="get" class="d-flex align-items-center flex-grow-1">
                <div class="search-wrapper flex-grow-1" style="max-width: 400px;">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="minimal-input w-100 text-primary bg-transparent" 
                           placeholder="Search logs...">
                </div>
            </form>
        </div>

        <div class="d-flex align-items-center gap-4">
            <form method="get" class="d-flex align-items-center gap-3">
                <select name="role" class="minimal-input text-primary" style="width: 150px; background: transparent; border: none;" onchange="this.form.submit()">
                    <option value="">All Roles</option>
                    <option value="Admin" selected="@(ViewBag.Role == "Admin")">Admin</option>
                    <option value="WarehouseStaff" selected="@(ViewBag.Role == "WarehouseStaff")">Warehouse Staff</option>
                    <option value="DeliveryRider" selected="@(ViewBag.Role == "DeliveryRider")">Delivery Rider</option>
                    <option value="SuperAdmin" selected="@(ViewBag.Role == "SuperAdmin")">SuperAdmin</option>
                </select>
            </form>
        </div>
    </div>

    <!-- Security Trace Table (Glass-Card) -->
    <div class="glass-card p-0 overflow-hidden mb-4">
        <div class="card-header bg-transparent border-bottom border-theme py-3 px-4 d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-primary d-flex align-items-center">
                <i class="bi bi-shield-lock-fill text-danger me-2"></i> Security Trace
            </h6>
        </div>
        <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle" id="secTable">
                <thead style="background: rgba(255,140,0,0.03);">
                    <tr>
                        <th class="ps-4 py-3 text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 1px; width: 170px;">Timestamp</th>
                        <th class="py-3 text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 1px; width: 160px;">User / Role</th>
                        <th class="py-3 text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 1px; width: 130px;">Action</th>
                        <th class="py-3 text-secondary text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 1px;">Details</th>
                        <th class="pe-4 py-3 text-secondary text-uppercase fw-semibold text-end" style="font-size: 0.75rem; letter-spacing: 1px; width: 100px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-secondary">
                                <i class="bi bi-shield-check" style="font-size: 2.5rem; display:block; margin-bottom: 10px; opacity: 0.3;"></i>
                                No security events recorded yet.<br>
                                <span style="font-size: 0.8rem;">Events appear here when users log in, fail authentication, or select a hub.</span>
                            </td>
                        </tr>
                    }
                    @foreach (var log in Model)
                    {
                        var isFailure = log.Action.Contains("Failed") || log.Action.Contains("Denied");
                        <tr style="border-bottom: 1px solid var(--border-color);">
                            <td class="ps-4 py-3">
                                <div class="text-primary small fw-semibold">@log.Timestamp.ToString("MMM dd, yyyy")</div>
                                <div class="text-secondary" style="font-size: 0.72rem;">@log.Timestamp.ToString("HH:mm:ss")</div>
                            </td>
                            <td class="py-3">
                                <div class="fw-bold text-warning small">@log.Actor</div>
                                <div class="text-secondary" style="font-size: 0.7rem;">
                                    @(log.Role == "WarehouseStaff" ? "Staff Account" : (log.Role == "Admin" ? "In-store Manager" : log.Role))
                                </div>
                            </td>
                            <td class="py-3">
                                <span class="badge border @(isFailure ? "border-danger text-danger bg-danger" : "border-success text-success bg-success") bg-opacity-10" style="font-size: 0.7rem;">
                                    @log.Action
                                </span>
                            </td>
                            <td class="py-3">
                                <div class="text-secondary small">@log.Detail</div>
                            </td>
                            <td class="py-3 text-end pe-4">
                                <span class="badge border @(isFailure ? "border-danger text-danger bg-danger" : "border-success text-success bg-success") bg-opacity-10" style="font-size: 0.7rem;">
                                    @(isFailure ? "Alert" : "Logged")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

    <!-- Pagination (Reference-Matched) -->
    @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
    {
        <div class="mt-4">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link bg-theme border-0 text-secondary px-3" href="?search=@ViewBag.Search&page=@(ViewBag.CurrentPage - 1)">Previous</a>
                </li>
                @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link @(i == (int)ViewBag.CurrentPage ? "bg-orange border-0" : "bg-theme border-0 text-secondary") mx-1 rounded" href="?search=@ViewBag.Search&page=@i">@i</a>
                    </li>
                }
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link bg-theme border-0 text-secondary px-3" href="?search=@ViewBag.Search&page=@(ViewBag.CurrentPage + 1)">Next</a>
                </li>
            </ul>
        </div>
    }
</div>

<script>
    function exportLogs() {
        const rows = [["Timestamp", "User", "Role", "Action", "Details", "Status"]];
        document.querySelectorAll('#secTable tbody tr').forEach(tr => {
            if(tr.innerText.includes("No security events")) return;
            const cols = Array.from(tr.querySelectorAll('td')).map(td => `"${td.innerText.replace(/"/g, '""')}"`);
            rows.push(cols);
        });
        const csv = rows.map(r => r.join(',')).join('\n');
        const blob = new Blob([csv], { type: 'text/csv' });
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.setAttribute('hidden', '');
        a.setAttribute('href', url);
        a.setAttribute('download', 'security_logs.csv');
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }
</script>
<style>.hover-white:hover { color: #fff !important; background: var(--brand-primary) !important; }</style>
