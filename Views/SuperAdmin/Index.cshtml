@model IEnumerable<SwiftFill.Models.ApplicationUser>
@{
    ViewData["Title"] = "System Configuration";
    Layout = "_AdminLayout";
}

<div class="animate-fade-up">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 border-bottom border-theme pb-3 gap-3">
        <div>
            <h1 class="fw-bold fs-3 mt-2 mb-0 text-primary"><i class="bi bi-gear-fill me-3 text-orange"></i> System Configuration</h1>
            <p class="text-secondary mt-1 mb-0" style="font-size: 0.9rem;">Architectural controls and global system modules.</p>
        </div>
        <div class="d-flex align-items-center">
            <span class="badge border border-secondary text-secondary px-3 py-2 fs-6 rounded-pill x-small">App Version 1.0.4</span>
        </div>
    </div>
    
    <!-- Top Stats -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card glass-card border-0 shadow-sm h-100">
                <div class="card-body p-3 p-md-4 border-start border-success border-4 rounded-start">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-check-circle-fill text-success me-2 x-small"></i>
                        <span class="text-success fw-bold text-uppercase x-small ls-1">System</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-end">
                        <div>
                            <h4 class="text-primary mb-1 fw-bold">Online</h4>
                            <div class="text-secondary x-small d-none d-md-block">All services running</div>
                        </div>
                        <i class="bi bi-activity text-success opacity-50" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card glass-card border-0 shadow-sm h-100">
                <div class="card-body p-3 p-md-4 border-start border-info border-4 rounded-start">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-box-seam-fill text-info me-2 x-small"></i>
                        <span class="text-info fw-bold text-uppercase x-small ls-1">Orders</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-end">
                        <div>
                            <h4 class="text-primary mb-1 fw-bold">@ViewBag.OrderCount</h4>
                            <div class="text-secondary x-small d-none d-md-block">Total recorded</div>
                        </div>
                        <i class="bi bi-cart-check text-info opacity-50" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Super Admin Capabilities Grid -->
    <h5 class="text-primary fw-bold mb-4">Super Admin Modules</h5>
    <div class="row g-4 mb-5">
        <!-- 1 -->
        <div class="col-6 col-md-4">
            <a href="/SuperAdmin/Users" class="text-decoration-none">
                <div class="card glass-card border-0 h-100 module-card">
                    <div class="card-body p-4 text-center">
                        <div class="icon-circle mx-auto mb-3" style="width: 60px; height: 60px; border-radius: 50%; background: rgba(255,140,0,0.1); display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-people-fill text-orange fs-3"></i>
                        </div>
                        <h5 class="text-primary fw-bold">Manage Users & Roles</h5>
                        <p class="text-secondary small mb-0 mt-2">Create, edit, and deactivate staff accounts (Admins, Warehouse, Riders) and manage access.</p>
                    </div>
                </div>
            </a>
        </div>
        <!-- 2 -->
        <div class="col-6 col-md-4">
            <a href="/SuperAdmin/Warehouses" class="text-decoration-none">
                <div class="card glass-card border-0 h-100 module-card">
                    <div class="card-body p-4 text-center">
                        <div class="icon-circle mx-auto mb-3" style="width: 60px; height: 60px; border-radius: 50%; background: rgba(13, 110, 253, 0.1); display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-buildings text-primary fs-3"></i>
                        </div>
                        <h5 class="text-primary fw-bold">System & Hub Configuration</h5>
                        <p class="text-secondary small mb-0 mt-2">Define the shipping network by adding and managing physical Hub locations across regions.</p>
                    </div>
                </div>
            </a>
        </div>
        <!-- 3 -->
        <div class="col-6 col-md-4">
            <a href="/SuperAdmin/SecurityLogs" class="text-decoration-none">
                <div class="card glass-card border-0 h-100 module-card">
                    <div class="card-body p-4 text-center">
                        <div class="icon-circle mx-auto mb-3" style="width: 60px; height: 60px; border-radius: 50%; background: rgba(220, 53, 69, 0.1); display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-shield-lock-fill text-danger fs-3"></i>
                        </div>
                        <h5 class="text-primary fw-bold">Security Logs</h5>
                        <p class="text-secondary small mb-0 mt-2">Monitor access attempts, policy changes, and security events to ensure data integrity.</p>
                    </div>
                </div>
            </a>
        </div>
        <!-- 4 -->
        <div class="col-6 col-md-4">
            <a href="/SuperAdmin/SystemLogs" class="text-decoration-none">
                <div class="card glass-card border-0 h-100 module-card">
                    <div class="card-body p-4 text-center">
                        <div class="icon-circle mx-auto mb-3" style="width: 60px; height: 60px; border-radius: 50%; background: rgba(25, 135, 84, 0.1); display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-cpu text-success fs-3"></i>
                        </div>
                        <h5 class="text-primary fw-bold">System Logs</h5>
                        <p class="text-secondary small mb-0 mt-2">Track application errors, background job executions, and infrastructure events.</p>
                    </div>
                </div>
            </a>
        </div>
        <!-- 5 -->
        <div class="col-6 col-md-4">
            <a href="/SuperAdmin/Branding" class="text-decoration-none">
                <div class="card glass-card border-0 h-100 module-card">
                    <div class="card-body p-4 text-center">
                        <div class="icon-circle mx-auto mb-3" style="width: 60px; height: 60px; border-radius: 50%; background: rgba(214, 51, 132, 0.1); display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-palette text-pink" style="color: #d63384; font-size: 1.8rem;"></i>
                        </div>
                        <h5 class="text-primary fw-bold">Manage Branding</h5>
                        <p class="text-secondary small mb-0 mt-2">Edit color themes and redesign the system logo to match your company's identity.</p>
                    </div>
                </div>
            </a>
        </div>
        <!-- 6 -->
        <div class="col-6 col-md-4">
            <a asp-controller="Account" asp-action="Settings" class="text-decoration-none">
                <div class="card glass-card border-0 h-100 module-card">
                    <div class="card-body p-4 text-center">
                        <div class="icon-circle mx-auto mb-3" style="width: 60px; height: 60px; border-radius: 50%; background: rgba(255, 140, 0, 0.1); display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-person-gear text-orange fs-3"></i>
                        </div>
                        <h5 class="text-primary fw-bold">Account Settings</h5>
                        <p class="text-secondary small mb-0 mt-2">Manage your administrative profile, update your password, and security preferences.</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>

<style>
    .module-card:hover {
        background: var(--card-bg-hover) !important;
        transform: translateY(-5px);
        box-shadow: var(--card-shadow) !important;
        border-color: var(--brand-primary) !important;
    }
    .hover-white:hover {
        color: #ffffff !important;
        background: var(--brand-primary) !important;
    }
</style>

