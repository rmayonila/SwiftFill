@model IEnumerable<SwiftFill.Models.RoleWithPermissionsViewModel>
@{
    ViewData["Title"] = "Roles & Permissions - SwiftFill";
    Layout = "_AdminLayout";
}

<div class="animate-fade-up">
    <!-- Top Header Area -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-theme pb-3">
        <div>
            <h1 class="fw-bold fs-3 mt-2 mb-0 text-primary"><i class="bi bi-shield-check text-orange me-3"></i> Roles & Permissions</h1>
            <p class="text-secondary mt-1" style="font-size: 1rem;">Manage system-wide roles and their granular module permissions.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge border border-success text-success bg-success bg-opacity-10 px-3 py-2" style="border-radius: 8px;">
                <i class="bi bi-shield-check me-2"></i>Total Roles: @Model.Count()
            </span>
        </div>
    </div>

    <!-- Search & Filter Bar (Reference-Matched Format) -->
    <div class="d-flex justify-content-between align-items-center mb-4 gap-3 bg-theme-soft p-2 rounded-3" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
        <div class="d-flex align-items-center flex-grow-1 gap-3">
            <form method="get" class="d-flex align-items-center flex-grow-1">
                <div class="search-wrapper flex-grow-1" style="max-width: 400px;">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="minimal-input w-100 text-primary bg-transparent" 
                           placeholder="Search role name or identity...">
                </div>
            </form>
        </div>

        <div class="d-flex align-items-center gap-4">
            <button class="btn btn-warning fw-bold px-4 py-2 shadow-sm d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#createRoleModal" style="border-radius: 8px; color: #000; font-size: 0.85rem;">
                <i class="bi bi-plus-lg me-2"></i>Create New Role
            </button>
        </div>
    </div>

    <div class="row g-4">
        <!-- Roles List (Glass-Card) -->
        <div class="col-lg-12">
            <div class="glass-card p-0 overflow-hidden">
                <div class="card-header bg-transparent border-bottom border-theme py-3 px-4 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold d-flex align-items-center text-primary">
                        <i class="bi bi-list-ul text-orange me-3" style="font-size: 1.2rem;"></i> 
                        System Roles & Access Levels
                    </h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background: rgba(255,140,0,0.03);">
                            <tr class="text-secondary small text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 1px;">
                                <th class="ps-4 py-3" style="width: 25%;">Role Name</th>
                                <th class="py-3" style="width: 55%;">Inherited Permissions</th>
                                <th class="pe-4 py-3 text-end" style="width: 20%;">Controls</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr style="border-bottom: 1px solid var(--border-color);">
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle d-flex justify-content-center align-items-center me-3" 
                                                 style="width: 35px; height: 35px; background: rgba(255,140,0,0.1); color: #ff8c00; font-weight: bold;">
                                                @(item.RoleName.Substring(0,1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-bold text-primary mb-1" style="font-size: 0.95rem;">@item.RoleName</div>
                                                @if(item.RoleName == "SuperAdmin"){ <span class="text-secondary x-small"><i class="bi bi-patch-check-fill text-info me-1"></i>System Owner</span> }
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3">
                                        <div class="d-flex flex-wrap gap-1">
                                            @if (item.Permissions.Any())
                                            {
                                                @foreach (var perm in item.Permissions)
                                                {
                                                    <span class="text-secondary" style="font-size: 0.65rem; border: 1px solid var(--border-color); padding: 1px 6px; border-radius: 4px; background: rgba(255,255,255,0.02);">
                                                        @perm.Replace("Permissions.", "")
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted smaller italic">No foundational claims assigned</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-theme" title="Edit Permissions" 
                                                    onclick="openEditPermissionsModal('@item.RoleId', '@item.RoleName', '@string.Join(",", item.Permissions)')">
                                                <i class="bi bi-shield-lock"></i>
                                            </button>
                                            
                                            @if (item.RoleName != "SuperAdmin")
                                            {
                                                <button class="btn btn-sm btn-theme border-danger text-danger mx-1" title="Delete Role" 
                                                        onclick="confirmDeleteRole('@item.RoleId', '@item.RoleName')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-theme disabled opacity-25 mx-1" title="System Protected">
                                                    <i class="bi bi-lock-fill"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-5">
                                        <i class="bi bi-shield-slash text-secondary d-block mb-3" style="font-size: 2.5rem;"></i>
                                        <p class="text-secondary">No roles found matching "@ViewBag.Search"</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Create Role Modal (Reference-Matched Format) -->
<div class="modal fade" id="createRoleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--modal-bg); border: 1px solid var(--border-color); border-radius: 12px; backdrop-filter: blur(10px);">
            <div class="modal-header border-theme">
                <h5 class="modal-title fw-bold text-primary"><i class="bi bi-shield-plus text-warning me-2"></i> Create System Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="CreateRole" method="post">
                <div class="modal-body py-4">
                    <label class="form-label text-secondary small">Identity Name</label>
                    <input type="text" name="roleName" class="form-control bg-theme border-theme text-primary shadow-none" placeholder="e.g. HubManager" required>
                    <div class="form-text smaller text-muted mt-2">This name will be used throughout the system for RBAC logic.</div>
                </div>
                <div class="modal-footer border-theme">
                    <button type="button" class="btn btn-dark" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning fw-bold text-dark px-4">Create Role</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Permissions Modal (Reference-Matched Format) -->
<div class="modal fade" id="editPermissionsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background: var(--modal-bg); border: 1px solid var(--border-color); border-radius: 12px; backdrop-filter: blur(10px);">
            <div class="modal-header border-theme">
                <h5 class="modal-title fw-bold text-primary"><i class="bi bi-key-fill text-info me-2"></i> Permissions for: <span id="edit_roleNameLabel" class="text-warning"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="UpdateRolePermissions" method="post">
                <div class="modal-body py-4">
                    <input type="hidden" name="roleId" id="edit_roleId" />
                    
                    <div class="row g-3">
                        @{
                            var allPerms = ViewBag.AllPermissions as List<string> ?? new List<string>();
                            var groups = allPerms.GroupBy(p => p.Split('.')[1]);
                        }
                        @foreach (var group in groups)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="p-3 rounded border border-theme bg-theme-soft h-100">
                                    <h6 class="text-warning small fw-bold mb-3 text-uppercase" style="letter-spacing: 1.2px; font-size: 0.65rem;">@group.Key</h6>
                                    @foreach (var perm in group)
                                    {
                                        <div class="form-check mb-2">
                                            <input class="form-check-input permission-checkbox" type="checkbox" name="permissions" value="@perm" id="perm_@perm.Replace(".", "_")">
                                            <label class="form-check-label text-secondary smaller fw-medium" for="perm_@perm.Replace(".", "_")">
                                                @perm.Split('.').Last()
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer border-theme">
                    <button type="button" class="btn btn-dark" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-info fw-bold text-dark px-4">Apply Access Rules</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal (Archive Format Matched) -->
<div class="modal fade" id="deleteRoleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content border-0 shadow-lg" style="background: var(--modal-bg); border-radius: 16px; border: 1px solid var(--border-color) !important; backdrop-filter: blur(10px);">
            <div class="modal-body text-center p-4">
                <div class="display-4 text-danger mb-3"><i class="bi bi-shield-slash"></i></div>
                <h5 class="text-primary fw-bold mb-2">Delete Role?</h5>
                <p class="text-secondary small mb-4">Are you sure you want to permanently remove <strong id="deleteRoleName" class="text-primary"></strong>? Users in this role will lose their permissions.</p>
                <form asp-action="DeleteRole" method="post">
                    <input type="hidden" name="roleId" id="deleteRoleId" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-dark flex-fill" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger flex-fill fw-bold">Yes, Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function openEditPermissionsModal(id, name, currentPerms) {
        document.getElementById('edit_roleId').value = id;
        document.getElementById('edit_roleNameLabel').textContent = name;
        
        const checkboxes = document.querySelectorAll('.permission-checkbox');
        checkboxes.forEach(cb => cb.checked = false);
        
        if (currentPerms) {
            const perms = currentPerms.split(',');
            perms.forEach(p => {
                const cb = document.querySelector(`.permission-checkbox[value="${p}"]`);
                if (cb) cb.checked = true;
            });
        }
        
        new bootstrap.Modal(document.getElementById('editPermissionsModal')).show();
    }

    function confirmDeleteRole(id, name) {
        document.getElementById('deleteRoleId').value = id;
        document.getElementById('deleteRoleName').textContent = name;
        new bootstrap.Modal(document.getElementById('deleteRoleModal')).show();
    }
</script>
