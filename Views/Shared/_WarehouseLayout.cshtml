<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Warehouse</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <style>
        /* ===== GLOBAL SIDEBAR LAYOUT ===== */
        body { background-color: var(--bg-color); color: var(--text-primary); font-family: 'Inter', sans-serif; overflow-x: hidden; }

        .sidebar {
            width: 260px;
            position: fixed;
            top: 0; left: 0;
            height: 100vh;
            background: var(--sidebar-gradient);
            border-right: 1px solid var(--border-color);
            padding-top: 0;
            z-index: 1050;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .sidebar .nav-sidebar-wrap {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding-bottom: 16px;
        }
        .sidebar .nav-sidebar-wrap::-webkit-scrollbar { width: 4px; }
        .sidebar .nav-sidebar-wrap::-webkit-scrollbar-thumb { background: rgba(255,140,0,0.25); border-radius: 4px; }

        .main-content {
            margin-left: 260px;
            padding: 20px 36px;
            min-height: 100vh;
            background: var(--bg-color);
            transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Responsive Breakpoints */
        @@media (max-width: 991.98px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.show { transform: translateX(0); }
            .main-content { margin-left: 0; padding: 15px; }
            .top-header-mobile { display: flex !important; }
            .search-container { width: 100% !important; }
            .module-toolbar { flex-direction: column; gap: 15px; align-items: stretch !important; }
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            padding: 20px 22px 16px;
            text-decoration: none;
            border-bottom: 1px solid var(--border-color);
            flex-shrink: 0;
        }
        .sidebar-brand .brand-text {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-primary);
            letter-spacing: 0.5px;
        }

        .nav-sidebar .nav-link {
            color: var(--text-secondary);
            padding: 12px 22px;
            min-height: 50px;
            font-size: 0.88rem;
            font-weight: 500;
            line-height: 1.4;
            transition: background 0.2s, color 0.2s, border-color 0.2s;
            border-left: 3px solid transparent;
            display: flex;
            align-items: center;
            white-space: nowrap;
        }

        .nav-sidebar .nav-link:hover,
        .nav-sidebar .nav-link.active {
            color: #ffffff;
            background: rgba(255, 140, 0, 0.08);
            border-left: 3px solid #ff8c00;
        }
        .nav-sidebar .nav-link.active {
            color: #FF8C00;
            background: rgba(255,140,0,0.12);
            box-shadow: inset 4px 0 10px rgba(255,140,0,0.1);
        }

        .nav-sidebar .nav-link i {
            margin-right: 11px;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .sidebar-logout {
            padding: 16px 22px;
            border-top: 1px solid var(--border-color);
            flex-shrink: 0;
        }
        
        .dashboard-title { font-size: 2.2rem; font-weight: 800; color: #ff8c00; margin-bottom: 30px; display: flex; align-items: center; }
        
        /* Mobile dashboard title adjustment */
        @@media (max-width: 767.98px) {
            .dashboard-title { font-size: 1.5rem; }
        }

        .table-container { background: #0a0a0a; border: 1px solid #1a1a1a; border-radius: 15px; padding: 20px; overflow-x: auto; }
        
        /* Module Page Standard Styles */
        .module-toolbar {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .search-container {
            position: relative;
            width: 350px;
        }
        .search-container i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
        }
        .search-container input {
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 10px 15px 10px 40px;
            color: var(--text-primary);
            width: 100%;
            outline: none;
            transition: border-color 0.2s;
        }
        .search-container input:focus {
            border-color: #ff8c00;
        }
        .filter-btn {
            background: var(--bg-color);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 10px 20px;
            border-radius: 8px;
            transition: background 0.2s;
            text-decoration: none;
            display: inline-block;
            cursor: pointer;
        }
        .filter-btn:hover {
            background: #1a1a1a;
            color: #ff8c00;
        }
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid var(--border-color);
        }
        .page-info { color: #6c757d; font-size: 0.9rem; }
        
        /* Mobile pagination adjustment */
        @@media (max-width: 575.98px) {
            .pagination-container { flex-direction: column; gap: 15px; text-align: center; }
        }

        /* Theme Toggle Styling */
        .theme-toggle-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            width: 35px;
            height: 35px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 1rem;
            margin-right: 15px;
        }
        .theme-toggle-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
            border-color: #ff8c00;
        }
        [data-theme="light"] .theme-toggle-btn {
            background: rgba(0, 0, 0, 0.05);
        }
    </style>
</head>
<body>
    <!-- Mobile Top Header -->
    <div class="top-header-mobile" style="display:none; justify-content: space-between; align-items: center; padding: 15px 20px; background: var(--sidebar-gradient); border-bottom: 1px solid var(--border-color); position: sticky; top: 0; z-index: 1000;">
        <div class="d-flex align-items-center">
            <button class="sidebar-toggler" onclick="toggleSidebar()" style="background:transparent; border:none; color:var(--text-primary); font-size:1.5rem; margin-right:15px;">
                <i class="bi bi-list"></i>
            </button>
            <img src="~/images/logo.png" style="height:30px;" alt="Logo" />
        </div>
        <div class="rounded-circle d-flex justify-content-center align-items-center fw-bold" style="width: 32px; height: 32px; background: #ff8c00; color: #fff; font-size: 0.8rem;">
            @((User.Identity?.Name ?? "W").Substring(0,1).ToUpper())
        </div>
    </div>

    <!-- Left Sidebar -->
    <div class="sidebar" id="sidebar">
        <a href="/" class="sidebar-brand">
            <img src="~/images/logo.png" style="height:40px;" alt="SwiftFill" />
            <span class="brand-text ms-2">SwiftFill</span>
        </a>

        @{ 
            string action = ViewContext.RouteData.Values["Action"]?.ToString() ?? ""; 
            string currentHub = ViewBag.CurrentHub as string ?? Context.Session.GetString("UserHub") ?? "Davao Hub";
        }

        <div class="nav-sidebar-wrap">
            <ul class="nav flex-column nav-sidebar">
                <li class="nav-item">
                    <div class="px-4 mt-3 mb-2 text-secondary text-uppercase x-small ls-1">Main Menu</div>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(action == "Dashboard" ? "active" : "")" asp-controller="Warehouse" asp-action="Dashboard">
                        <i class="bi bi-grid-1x2-fill"></i> Dashboard Overview
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(action == "WarehouseQueue" ? "active" : "")" asp-controller="Warehouse" asp-action="WarehouseQueue">
                        <i class="bi bi-boxes"></i> Warehouse Queue
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(action == "HubTransfers" ? "active" : "")" asp-controller="Warehouse" asp-action="HubTransfers">
                        <i class="bi bi-map-fill"></i> Hub Transfers
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(action == "PackingLine" ? "active" : "")" asp-controller="Warehouse" asp-action="PackingLine">
                        <i class="bi bi-box-seam-fill"></i> Packing Line
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(action == "OrderHistory" ? "active" : "")" asp-controller="Warehouse" asp-action="OrderHistory">
                        <i class="bi bi-clock-history"></i> Order History
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "RiderInfo" ? "active" : "")" asp-controller="RiderInfo" asp-action="Index">
                        <i class="bi bi-people-fill"></i> Rider List
                    </a>
                </li>

                <div class="px-4 mt-4 mb-2 text-secondary text-uppercase x-small ls-1">Account</div>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" && ViewContext.RouteData.Values["action"]?.ToString() == "Settings" ? "active" : "")" asp-controller="Account" asp-action="Settings" asp-route-view="warehouse">
                        <i class="bi bi-gear-fill"></i> Account Settings
                    </a>
                </li>
            </ul>
        </div>

        <div class="sidebar-logout">
            <button type="button" class="btn w-100 fw-bold" data-bs-toggle="modal" data-bs-target="#logoutConfirmationModal"
                style="border:1px solid rgba(220,53,69,0.4);color:rgba(220,53,69,0.8);background:rgba(220,53,69,0.05);border-radius:8px;font-size:0.85rem;padding:10px;">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
        <!-- Dashboard Top Header -->
        <div class="d-flex justify-content-between justify-content-md-end align-items-center mb-4 pb-3">
            <div class="d-md-none d-flex align-items-center">
                <h5 class="m-0 fw-bold text-orange">Warehouse Panel</h5>
            </div>
            <button id="themeToggle" class="theme-toggle-btn" title="Toggle Theme">
                <i class="bi bi-moon-stars-fill dark-icon"></i>
                <i class="bi bi-sun-fill light-icon d-none"></i>
            </button>
            <a asp-controller="Account" asp-action="Settings" asp-route-view="warehouse" class="d-flex align-items-center text-decoration-none" title="Account Settings">
                <div class="rounded-circle d-flex justify-content-center align-items-center fw-bold shadow-sm" style="width: 35px; height: 35px; background: #ff8c00; color: #fff;">
                    @((User.Identity?.Name ?? "W").Substring(0,1).ToUpper())
                </div>
                <span class="ms-2 fw-semibold text-primary d-none d-sm-inline">@User.Identity?.Name</span>
            </a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-success mb-4" role="alert" style="background: var(--bg-secondary); color: #198754;">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const themeToggle = document.getElementById('themeToggle');
            const darkIcon = themeToggle.querySelector('.dark-icon');
            const lightIcon = themeToggle.querySelector('.light-icon');
            
            function updateIcons(theme) {
                if (theme === 'light') {
                    darkIcon.classList.add('d-none');
                    lightIcon.classList.remove('d-none');
                } else {
                    darkIcon.classList.remove('d-none');
                    lightIcon.classList.add('d-none');
                }
            }

            // Set initial icon state
            const currentTheme = document.documentElement.getAttribute('data-theme');
            updateIcons(currentTheme);

            themeToggle.addEventListener('click', () => {
                const theme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', theme);
                localStorage.setItem('theme', theme);
                updateIcons(theme);
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('show');
        }

        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', function(event) {
            const sidebar = document.getElementById('sidebar');
            const toggler = document.querySelector('.sidebar-toggler');
            const mobileHeader = document.querySelector('.top-header-mobile');
            
            if (window.innerWidth < 992 && sidebar && sidebar.classList.contains('show')) {
                if (!sidebar.contains(event.target) && (!mobileHeader || !mobileHeader.contains(event.target))) {
                    sidebar.classList.remove('show');
                }
            }
        });
    </script>

    <!-- Logout Confirmation Modal -->
    <div class="modal fade" id="logoutConfirmationModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content border-0 shadow-lg" style="background: var(--modal-bg); border-radius: 16px; border: 1px solid var(--border-color) !important;">
                <div class="modal-body text-center p-4">
                    <div class="display-4 text-danger mb-3"><i class="bi bi-box-arrow-right"></i></div>
                    <h5 class="text-primary fw-bold mb-2">Sign Out?</h5>
                    <p class="text-secondary small mb-4">Are you sure you want to log out of SwiftFill?</p>
                    <form method="post" action="/Account/Logout">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-dark flex-fill" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger flex-fill fw-bold">Yes, Logout</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>