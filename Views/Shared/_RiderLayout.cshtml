<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rider</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
    <style>
        /* ===== RESPONSIVE RIDER LAYOUT ===== */
        :root {
            --sidebar-width: 260px;
            --mobile-nav-height: 70px;
        }

        body { 
            background-color: var(--bg-color); 
            color: var(--text-primary); 
            font-family: 'Inter', sans-serif;
            margin: 0; padding: 0;
            overflow-x: hidden;
        }

        /* Sidebar - Hidden on mobile */
        .sidebar {
            width: var(--sidebar-width);
            position: fixed;
            top: 0; left: 0;
            height: 100vh;
            background: var(--sidebar-gradient);
            border-right: 1px solid var(--border-color);
            z-index: 1050;
            display: flex;
            flex-direction: column;
            transition: all 0.3s ease;
        }

        /* Main Content - Full width on mobile, shifted on desktop */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 24px;
            min-height: 100vh;
            background: var(--bg-color);
            transition: all 0.3s ease;
            padding-bottom: calc(var(--mobile-nav-height) + 20px); /* Space for bottom nav */
        }

        /* Top Bar - sticky for mobile */
        .rider-topbar {
            padding: 16px 24px;
            background: var(--nav-bg);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            padding: 24px 22px;
            text-decoration: none;
            border-bottom: 1px solid var(--border-color);
        }
        .brand-text {
            font-family: 'Sora', sans-serif;
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-primary);
            letter-spacing: -0.5px;
        }

        .nav-sidebar .nav-link {
            color: var(--text-secondary);
            padding: 14px 22px;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s;
            border-left: 3px solid transparent;
            display: flex;
            align-items: center;
        }

        .nav-sidebar .nav-link:hover,
        .nav-sidebar .nav-link.active {
            color: #ffffff;
            background: rgba(255, 140, 0, 0.08);
            border-left: 3px solid #ff8c00;
        }
        .nav-sidebar .nav-link.active {
            color: #FF8C00;
            background: rgba(255,140,0,0.12);
        }

        .nav-sidebar .nav-link i {
            margin-right: 12px;
            font-size: 1.1rem;
        }

        /* Bottom Nav - Only visible on small screens */
        .bottom-nav {
            position: fixed;
            bottom: 0; left: 0; right: 0;
            height: var(--mobile-nav-height);
            background: var(--sidebar-gradient);
            backdrop-filter: blur(20px);
            border-top: 1px solid var(--border-color);
            display: none;
            justify-content: space-around;
            align-items: center;
            z-index: 1060;
            padding: 0 10px;
        }

        .bottom-nav-link {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.7rem;
            font-weight: 600;
            gap: 4px;
            transition: all 0.2s;
        }

        .bottom-nav-link i { font-size: 1.4rem; }
        .bottom-nav-link.active { color: #ff8c00; }

        /* Responsive Breakpoints */
        @@media (max-width: 991.98px) {
            .sidebar { transform: translateX(-100%); }
            .sidebar.show { transform: translateX(0); }
            .main-content { margin-left: 0; padding: 15px; }
            .bottom-nav { display: flex; }
        }

        /* Hamburger Toggle */
        .sidebar-toggler {
            background: transparent;
            border: none;
            color: var(--text-primary);
            font-size: 1.5rem;
            display: none;
        }

        @@media (max-width: 991.98px) {
            .sidebar-toggler { display: block; }
        }

        .profile-btn {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: var(--text-primary);
            padding: 5px 6px 5px 16px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.2s;
            cursor: pointer;
        }
        .profile-btn:hover {
            background: rgba(255, 140, 0, 0.08);
            border-color: rgba(255, 140, 0, 0.2);
        }

        .sidebar-logout {
            padding: 16px 22px;
            border-top: 1px solid var(--border-color);
            flex-shrink: 0;
            margin-top: auto;
        }

        /* ===== SEARCH BAR STYLING (Remove White BG) ===== */
        .module-toolbar {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 15px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .search-container {
            position: relative;
            width: 100%;
        }
        .search-container i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
        }
        .search-container input {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 12px 15px 12px 45px;
            color: var(--text-primary);
            width: 100%;
            outline: none;
            transition: all 0.3s ease;
        }
        .search-container input:focus {
            background: rgba(255, 140, 0, 0.05);
            border-color: #ff8c00;
            box-shadow: 0 0 15px rgba(255, 140, 0, 0.1);
        }
        .search-container input::placeholder {
            color: var(--text-secondary);
        }
        
        .theme-toggle-btn {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            width: 35px; height: 35px; border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: all 0.3s ease;
        }
        .theme-toggle-btn:hover { border-color: #ff8c00; transform: translateY(-2px); }
    </style>
</head>
<body>
    <!-- Left Sidebar (Desktop) -->
    <div class="sidebar" id="sidebar">
        <a href="/" class="sidebar-brand">
            <img src="~/images/logo.png" style="height:35px;" alt="Logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/709/709790.png'" />
            <span class="brand-text ms-2">SwiftFill</span>
        </a>

        @{ 
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        }

        <div class="pt-4 flex-grow-1">
            <ul class="nav flex-column nav-sidebar">
                <li class="nav-item">
                    <div class="px-4 mt-3 mb-2 text-secondary text-uppercase x-small ls-1">Main Menu</div>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Rider" && currentAction == "Index" ? "active" : "")" asp-controller="Rider" asp-action="Index">
                        <i class="bi bi-geo-alt-fill"></i> Delivery Route
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Rider" && currentAction == "History" ? "active" : "")" asp-controller="Rider" asp-action="History">
                        <i class="bi bi-clock-history"></i> Completed
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Rider" && currentAction == "Remittance" ? "active" : "")" asp-controller="Rider" asp-action="Remittance">
                        <i class="bi bi-currency-dollar"></i> Remittance
                    </a>
                </li>
                <li class="nav-item">
                    <div class="px-4 mt-4 mb-2 text-secondary text-uppercase x-small ls-1">Account</div>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Account" && currentAction == "Settings" ? "active" : "")" asp-controller="Account" asp-action="Settings">
                        <i class="bi bi-gear-fill"></i> Account Settings
                    </a>
                </li>
                <li class="nav-item mt-2 d-lg-none">
                    <a href="javascript:void(0)" class="nav-link text-danger border-0" data-bs-toggle="modal" data-bs-target="#logoutConfirmationModal" style="background: transparent;">
                        <i class="bi bi-box-arrow-right"></i> Log Out
                    </a>
                </li>
            </ul>
        </div>

        <div class="sidebar-logout d-none d-lg-block">
            <button type="button" class="btn w-100 fw-bold" data-bs-toggle="modal" data-bs-target="#logoutConfirmationModal"
                style="border:1px solid rgba(220,53,69,0.4);color:rgba(220,53,69,0.8);background:rgba(220,53,69,0.05);border-radius:8px;font-size:0.85rem;padding:10px;">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>
        </div>


    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <button class="sidebar-toggler btn btn-link text-primary p-0" onclick="toggleSidebar()">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div class="d-md-none">
                    <img src="~/images/logo.png" style="height:28px;" alt="Logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/709/709790.png'" />
                </div>
            </div>
            
            <div class="d-flex align-items-center gap-3">
                <button id="themeToggle" class="theme-toggle-btn" title="Toggle Theme">
                    <i class="bi bi-moon-stars-fill dark-icon"></i>
                    <i class="bi bi-sun-fill light-icon d-none"></i>
                </button>
                <a asp-controller="Account" asp-action="Settings" class="d-flex align-items-center text-decoration-none" title="Account Settings">
                    <div class="rounded-circle d-flex justify-content-center align-items-center fw-bold shadow-sm" style="width:32px; height:32px; background: #ff8c00; color: #fff; font-size: 0.8rem;">
                         @((User.Identity?.Name ?? "R").Substring(0,1).ToUpper())
                    </div>
                    <span class="ms-2 fw-semibold text-primary small">@User.Identity?.Name</span>
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show bg-dark text-success border-success mb-4 mx-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show bg-dark text-danger border-danger mb-4 mx-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </div>

    <!-- Bottom Navigation (Mobile) -->
    <nav class="bottom-nav">
        <a class="bottom-nav-link @(currentController == "Rider" && currentAction == "Index" ? "active" : "")" asp-controller="Rider" asp-action="Index">
            <i class="bi bi-geo-alt"></i>
            <span>Route</span>
        </a>
        <a class="bottom-nav-link @(currentController == "Rider" && currentAction == "History" ? "active" : "")" asp-controller="Rider" asp-action="History">
            <i class="bi bi-check2-circle"></i>
            <span>History</span>
        </a>
        <a class="bottom-nav-link @(currentController == "Rider" && currentAction == "Remittance" ? "active" : "")" asp-controller="Rider" asp-action="Remittance">
            <i class="bi bi-wallet2"></i>
            <span>Cash</span>
        </a>
        <a href="javascript:void(0)" class="bottom-nav-link" data-bs-toggle="offcanvas" data-bs-target="#userOffcanvas">
            <i class="bi bi-person-circle"></i>
            <span>Account</span>
        </a>
    </nav>

    <!-- Account Offcanvas (Mobile) -->
    <div class="offcanvas offcanvas-bottom bg-dark text-white border-top border-orange" tabindex="-1" id="userOffcanvas" style="height: auto; border-radius: 20px 20px 0 0;">
        <div class="offcanvas-header border-bottom border-secondary border-opacity-10 py-4">
            <h5 class="offcanvas-title fw-bold">My Account</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body p-4">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle bg-orange text-dark fw-bold d-flex align-items-center justify-content-center" style="width:60px; height:60px; font-size: 1.5rem;">
                     @((User.Identity?.Name ?? "R").Substring(0,1).ToUpper())
                </div>
                <div>
                    <h5 class="mb-0 fw-bold">@User.Identity?.Name</h5>
                    <p class="text-secondary small mb-0">Delivery Partner • SwiftFill</p>
                </div>
            </div>
            <div class="list-group list-group-flush mb-4">
                <a asp-controller="Account" asp-action="Settings" class="list-group-item list-group-item-action bg-transparent text-white border-secondary border-opacity-10 py-3 px-0">
                    <i class="bi bi-gear-fill me-3 text-orange"></i> Account Settings
                </a>
            </div>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const themeToggle = document.getElementById('themeToggle');
            const darkIcon = themeToggle.querySelector('.dark-icon');
            const lightIcon = themeToggle.querySelector('.light-icon');
            
            function updateIcons(theme) {
                if (theme === 'light') {
                    darkIcon.classList.add('d-none');
                    lightIcon.classList.remove('d-none');
                } else {
                    darkIcon.classList.remove('d-none');
                    lightIcon.classList.add('d-none');
                }
            }

            // Set initial icon state
            const currentTheme = document.documentElement.getAttribute('data-theme');
            updateIcons(currentTheme);

            themeToggle.addEventListener('click', () => {
                const theme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', theme);
                localStorage.setItem('theme', theme);
                updateIcons(theme);
            });
        });

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('show');
        }
        
        // Close sidebar when clicking outside on mobile
        document.addEventListener('click', function(event) {
            const sidebar = document.getElementById('sidebar');
            const toggler = document.querySelector('.sidebar-toggler');
            if (window.innerWidth < 992 && sidebar.classList.contains('show') && !sidebar.contains(event.target) && !toggler.contains(event.target)) {
                sidebar.classList.remove('show');
            }
        });
    </script>

    <!-- Logout Confirmation Modal -->
    <div class="modal fade" id="logoutConfirmationModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
            <div class="modal-content border-0 shadow-lg" style="background: var(--modal-bg); border-radius: 16px; border: 1px solid var(--border-color) !important;">
                <div class="modal-body text-center p-4">
                    <div class="display-4 text-danger mb-3"><i class="bi bi-box-arrow-right"></i></div>
                    <h5 class="text-primary fw-bold mb-2">Sign Out?</h5>
                    <p class="text-secondary small mb-4">Are you sure you want to log out of SwiftFill?</p>
                    <form method="post" action="/Account/Logout">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-dark flex-fill" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger flex-fill fw-bold">Yes, Logout</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>