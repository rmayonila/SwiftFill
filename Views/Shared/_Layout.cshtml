@inject SwiftFill.Data.ApplicationDbContext _context
@{
    var brand = _context.BrandingSettings.FirstOrDefault() ?? new SwiftFill.Models.BrandingSettings();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SwiftFill</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Sora:wght@700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --brand-primary: @brand.PrimaryColor;
        }
        .navbar-brand img { height: 40px; }
        .btn-get-started { background: var(--brand-primary) !important; }

        /* Theme Toggle Styling */
        .theme-toggle-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 1.2rem;
        }
        .theme-toggle-btn:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
            border-color: var(--swift-orange);
        }
        [data-theme="light"] .theme-toggle-btn {
            background: rgba(0, 0, 0, 0.05);
        }
    </style>
    <script>
        // Pre-initialization to prevent flash of wrong theme
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-sm fixed-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="@(brand.TintedLogoUrl ?? brand.LogoUrl ?? "/images/logo.png")" class="brand-logo-img me-2" alt="SwiftFill" />
                    <span class="brand-text text-primary">@(string.IsNullOrEmpty(brand.BrandName) ? "SwiftFill" : brand.BrandName)</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <i class="bi bi-list text-primary fs-2"></i>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link" href="/#features">Features</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#modules">Modules</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#pricing">Pricing</a></li>
                        <li class="nav-item"><a class="nav-link" href="/#contact">Contact</a></li>
                    </ul>
                    <ul class="navbar-nav align-items-center gap-2 mt-3 mt-lg-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- If User is already logged in, show a quick back to dashboard button -->
                            var dashboardUrl = "/Customer";
                            var userName = User.Identity?.Name?.ToLower() ?? "";
                            
                            if (User.IsInRole("SuperAdmin")) dashboardUrl = "/SuperAdmin";
                            else if (User.IsInRole("Admin") && !userName.Contains("staff")) dashboardUrl = "/Admin";
                            else if (User.IsInRole("WarehouseStaff") || User.IsInRole("WarehouseOperator") || userName.Contains("staff")) dashboardUrl = "/Warehouse";
                            else if (User.IsInRole("DeliveryRider")) dashboardUrl = "/Rider";

                            <li class="nav-item">
                                <a class="btn-get-started" href="@dashboardUrl"><i class="bi bi-speedometer2"></i> My Dashboard</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Sign In</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn-get-started" href="/Account/SignUp">Get Started</a>
                            </li>
                        }
                        <li class="nav-item ms-lg-2">
                            <button id="themeToggle" class="theme-toggle-btn" title="Toggle Theme">
                                <i class="bi bi-moon-stars-fill dark-icon"></i>
                                <i class="bi bi-sun-fill light-icon d-none"></i>
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <main role="main">

            @RenderBody()
        </main>
    </div>

    <footer class="text-center">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                <div>
                    <img src="@(brand.TintedLogoUrl ?? brand.LogoUrl ?? "/images/logo.png")" style="height:24px; margin-right:8px;" alt="SwiftFill" /> <strong class="text-primary">@(string.IsNullOrEmpty(brand.BrandName) ? "SwiftFill" : brand.BrandName)</strong>
                </div>
                <div class="small opacity-50">
                    &copy; 2026 SwiftFill. All rights reserved.
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const themeToggle = document.getElementById('themeToggle');
            const darkIcon = themeToggle.querySelector('.dark-icon');
            const lightIcon = themeToggle.querySelector('.light-icon');
            
            function updateIcons(theme) {
                if (theme === 'light') {
                    darkIcon.classList.add('d-none');
                    lightIcon.classList.remove('d-none');
                } else {
                    darkIcon.classList.remove('d-none');
                    lightIcon.classList.add('d-none');
                }
            }

            // Set initial icon state
            const currentTheme = document.documentElement.getAttribute('data-theme');
            updateIcons(currentTheme);

            themeToggle.addEventListener('click', () => {
                const theme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-theme', theme);
                localStorage.setItem('theme', theme);
                updateIcons(theme);
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>