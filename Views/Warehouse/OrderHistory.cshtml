@model IEnumerable<SwiftFill.Models.Order>
@{
    Layout = "_WarehouseLayout";
    ViewData["Title"] = "Order History";
    var currentHub = ViewBag.CurrentHub as string ?? "Hub";
}

<div class="animate-fade-up">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold fs-3 mt-2 mb-0 text-primary"><i class="bi bi-clock-history text-orange me-2"></i> Order History</h2>
        <div class="text-secondary small">Hub: <span class="text-orange fw-bold">@currentHub</span></div>
    </div>

    <!-- Integrated Filter Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center mb-4 gap-3 bg-theme-soft p-2 rounded-3" style="border: 1px solid var(--border-color);">
        <div class="d-flex align-items-center flex-grow-1 gap-3">
            <form method="get" class="d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center flex-grow-1 gap-2">
                <div class="search-wrapper flex-grow-1" style="max-width: 400px; position: relative;">
                    <i class="bi bi-search" style="position: absolute; left: 15px; top: 50%; transform: translateY(-50%); color: var(--text-secondary);"></i>
                    <input type="text" name="search" value="@ViewBag.Search" class="minimal-input w-100" 
                           placeholder="Search Tracking ID, Receiver...">
                </div>
                <select name="status" class="minimal-input" style="min-width: 150px;" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="Delivered" selected='@(Context.Request.Query["status"] == "Delivered")'>Delivered</option>
                    <option value="Returned" selected='@(Context.Request.Query["status"] == "Returned")'>Returned</option>
                </select>
            </form>
        </div>
        <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-3">
             <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 fw-bold border border-success border-opacity-10">@Model.Count() COMPLETED</span>
        </div>
    </div>

    <div class="glass-card p-0 overflow-hidden" style="border: 1px solid var(--border-color);">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0">
                <thead style="background: rgba(255,140,0,0.03);">
                    <tr class="text-secondary small text-uppercase">
                        <th class="ps-4 py-3">Shipment Identity</th>
                        <th class="py-3">Completion Details</th>
                        <th class="py-3">Status</th>
                        <th class="py-3 pe-4 text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid rgba(255,255,255,0.02);">
                            <td class="ps-4 py-3">
                                <code class="text-orange fw-bold d-block">#@item.TrackingId</code>
                                <div class="text-primary small">@item.ReceiverName</div>
                                <div class="text-secondary x-small"><i class="bi bi-geo-alt me-1"></i>@item.ReceiverAddress</div>
                            </td>
                            <td class="py-3">
                                <div class="text-primary small">
                                    <i class="bi bi-calendar-check me-1"></i> @item.UpdatedAt.ToString("MMM dd, yyyy HH:mm")
                                </div>
                                <div class="text-secondary x-small">
                                    Attempts: @item.DeliveryAttempts • @(item.ItemCategory ?? "General")
                                </div>
                                @if (item.AssignedRider != null || item.ManualRider != null)
                                {
                                    string riderName = item.AssignedRider != null 
                                        ? $"{item.AssignedRider.FirstName} {item.AssignedRider.LastName}" 
                                        : item.ManualRider?.Name ?? "N/A";
                                    <div class="text-orange x-small fw-bold mt-1">
                                        <i class="bi bi-truck me-1"></i> @riderName
                                    </div>
                                }
                            </td>
                            <td class="py-3">
                                @{
                                    var statusClass = item.Status == "Delivered" ? "border-success text-success" : "border-danger text-danger";
                                }
                                <span class="badge border bg-transparent px-2 py-1 @statusClass" style="font-size: 0.65rem;">
                                    @item.Status.ToUpper()
                                </span>
                            </td>
                            <td class="py-3 pe-4 text-center">
                                <div class="d-flex justify-content-center align-items-center">
                                    <button class="btn btn-link text-info p-0 action-icon" onclick="viewDetails('@item.TrackingId')" title="View Details">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger border-0 p-1 ms-2" onclick="confirmArchive('@item.TrackingId')" title="Archive">
                                        <i class="bi bi-archive" style="font-size: 1.15rem;"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-secondary border-0">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No completed shipments found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="mt-4">
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link bg-dark border-0 text-secondary px-3" href="?page=@(ViewBag.CurrentPage - 1)&search=@ViewBag.Search">Previous</a>
                </li>
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link @(ViewBag.CurrentPage == i ? "bg-orange border-0" : "bg-dark border-0 text-secondary") mx-1 rounded" href="?page=@i&search=@ViewBag.Search">@i</a>
                    </li>
                }
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link bg-dark border-0 text-secondary px-3" href="?page=@(ViewBag.CurrentPage + 1)&search=@ViewBag.Search">Next</a>
                </li>
            </ul>
        </div>
    }
</div>

<!-- POD Modal -->
<div class="modal fade" id="podModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--modal-bg); border: 1px solid rgba(25, 135, 84, 0.2); border-radius: 20px;">
            <div class="modal-body p-4 text-center">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="text-start">
                        <div class="text-success x-small text-uppercase ls-1">Proof of Delivery</div>
                        <div class="fw-bold fs-5" id="podTrackingId" style="color: var(--text-primary);">#—</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <img id="podImage" src="" class="img-fluid rounded-3 shadow-lg" style="max-height: 500px; width: 100%; object-fit: cover; border: 1px solid rgba(255,255,255,0.05);" />
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: var(--modal-bg); border: 1px solid rgba(255,140,0,0.2); border-radius: 20px;">
            <div class="modal-body p-4" id="detailsContent">
                <div class="text-center py-4">
                    <div class="spinner-border text-orange" role="status"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Archive Confirmation Modal -->
<div class="modal fade" id="archiveModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 400px;">
        <div class="modal-content border-0 shadow-lg" style="background: var(--modal-bg); border-radius: 16px; border: 1px solid rgba(220,53,69,0.2) !important;">
            <div class="modal-body text-center p-4">
                <div class="display-4 text-danger mb-3"><i class="bi bi-exclamation-octagon"></i></div>
                <h5 class="text-primary fw-bold mb-2">Archive Shipment?</h5>
                <p class="text-secondary small mb-4">Are you sure you want to archive <strong id="archiveTrackingId" class="text-primary"></strong>? This will remove it from active management.</p>
                <form asp-action="ArchiveOrder" method="post" id="archiveForm">
                    <input type="hidden" name="trackingId" id="archiveTrackingIdInput" />
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-dark flex-fill" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger flex-fill fw-bold">Yes, Archive</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewPOD(url, tid) {
            document.getElementById('podImage').src = url;
            document.getElementById('podTrackingId').textContent = '#' + tid;
            new bootstrap.Modal(document.getElementById('podModal')).show();
        }

        function viewDetails(tid) {
            const modal = new bootstrap.Modal(document.getElementById('detailsModal'));
            document.getElementById('detailsContent').innerHTML = '<div class="text-center py-4"><div class="spinner-border text-orange" role="status"></div></div>';
            modal.show();
            
            fetch('/Warehouse/GetOrderDetails?trackingId=' + tid)
                .then(r => r.text())
                .then(html => {
                    document.getElementById('detailsContent').innerHTML = html;
                });
        }

        function confirmArchive(trackingId) {
            document.getElementById('archiveTrackingId').textContent = '#' + trackingId;
            document.getElementById('archiveTrackingIdInput').value = trackingId;
            new bootstrap.Modal(document.getElementById('archiveModal')).show();
        }
    </script>
}

<style>
    .bg-orange { background-color: #ff8c00; color: #000; }
    .x-small { font-size: 0.75rem; }
    .action-icon { font-size: 1.25rem; transition: transform 0.2s; }
    .action-icon:hover { transform: scale(1.2); }
    .minimal-input { background: var(--input-bg); border: 1px solid var(--border-color); border-radius: 8px; padding: 10px 15px; color: var(--text-primary); outline: none; }
</style>
